---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Casting from '../components/Casting.astro';
import Spotlight from '../components/Spotlight.astro';

import logo from '../assets/hero/adr-logo.png';
import fotoMedalhas from '../assets/hero/talento-1.jpg';
import fotoBlazer from '../assets/hero/foto-6.jpg';
import fotoRegata from '../assets/hero/talento-3.jpg';
import fotoEstudio from '../assets/hero/foto-5.jpg';
import fotoTattoo from '../assets/hero/talento-4.webp';

const logoVar = `--logo:url("${logo.src}")`;

// Cartões laterais do palco (inspirados no fan de perfis da referência)
const cards = [
	{ img: fotoMedalhas, word: 'Estratégia', line: 'Planejamento de influência', x: '-45%', y: '30px', r: '-5deg', depth: 26, d: '.95s', pos: '50% 30%', cls: 'c-outer-l', alt: 'Atleta do casting ADR mordendo uma medalha olímpica' },
	{ img: fotoEstudio, word: 'Casting', line: 'O talento certo para cada marca', x: '-27%', y: '62px', r: '3deg', depth: 16, d: '1.05s', pos: '50% 25%', cls: 'c-inner-l', alt: 'Retrato de estúdio de talento do casting ADR' },
	{ img: fotoRegata, word: 'Conteúdo', line: 'Narrativas que geram conexão', x: '27%', y: '34px', r: '-3deg', depth: 18, d: '1.1s', pos: '50% 22%', cls: 'c-inner-r', alt: 'Talento fitness do casting ADR' },
	{ img: fotoTattoo, word: 'Performance', line: 'Resultado que se mede', x: '45%', y: '84px', r: '5deg', depth: 28, d: '1.2s', pos: '50% 30%', cls: 'c-outer-r', alt: 'Talento do casting ADR com tatuagens' },
];

const ribbon = ['Estratégia', 'Casting', 'Campanhas', 'Conteúdo', 'Performance'];
---

<Layout>
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,100..900;1,100..900&family=Geist+Mono:wght@300..600&display=swap" rel="stylesheet" />

	<section class="hero" id="topo" data-hero style={logoVar}>
		<!-- ===================== FUNDO VIVO ===================== -->
		<div class="hero-bg" aria-hidden="true">
			<div class="grid-bg"></div>
			<div class="aurora aurora-blue a1"></div>
			<div class="aurora aurora-mint a2"></div>
			<div class="aurora aurora-lavender a3"></div>
			<div class="grid-beam" style="left:9%;animation-delay:-2s"></div>
			<div class="grid-beam" style="left:31%;animation-delay:-6s;animation-duration:11s"></div>
			<div class="grid-beam beam-md" style="left:72%;animation-delay:-4s;animation-duration:8s"></div>
			<div class="grid-beam beam-md" style="left:93%;animation-delay:-9s"></div>

			<!-- traços à mão livre, como na referência -->
			<svg class="scribble" viewBox="0 0 1440 900" preserveAspectRatio="none" fill="none">
				<path class="draw d1" d="M-40 230 C 160 20, 420 60, 380 300 S 120 640, 420 610 S 960 170, 1180 250 S 1500 520, 1480 430" />
				<path class="draw d2" d="M-60 560 C 240 420, 360 780, 640 580 S 1040 110, 1280 210 S 1460 620, 1520 660" />
				<path class="draw d3" d="M1500 120 C 1260 60, 1180 380, 980 320 S 760 40, 560 140" />
			</svg>

			<span class="ghost-text" data-text="ADR">ADR</span>
		</div>

		<!-- ===================== NAV ===================== -->
		<header class="nav">
			<div class="nav-left">
				<a href="#topo" class="nav-brand" aria-label="ADR Agência — início">
					<span class="logo-mark logo-mark-nav"></span>
				</a>
				<span class="nav-meta"><span class="live-dot"></span>Influência &amp; Performance</span>
			</div>
			<nav class="nav-links" aria-label="Principal">
				<a href="#sobre">Sobre</a>
				<a href="#casting">Casting</a>
				<a href="#cases">Cases</a>
				<a href="#contato">Contato</a>
			</nav>
			<a href="#contato" class="button button-small button-mint">
				Fale com a ADR
				<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M7 17 17 7M8 7h9v9" /></svg>
			</a>
		</header>

		<!-- ===================== COPY ===================== -->
		<div class="copy">
			<div class="brand-row">
				<span class="logo-mark" role="img" aria-label="ADR Agência"></span>
				<span class="brand-sep" aria-hidden="true"></span>
				<span class="badge-mono">Agência de influência</span>
			</div>

			<h1 class="headline">
				<span class="sr-only">Conectamos marcas, criadores e performance.</span>
				<span class="line" aria-hidden="true">
					<span class="w"><span style="--d:.25s">Conectamos</span></span>
					<span class="pill pill-solo" style="--d:.7s">
						<Image src={fotoMedalhas} alt="" width={200} loading="eager" />
					</span>
					<span class="w"><span class="text-outline text-outline-fill" style="--d:.35s">marcas,</span></span>
				</span>
				<span class="line" aria-hidden="true">
					<span class="w"><span style="--d:.45s">criadores</span></span>
					<span class="pill pill-trio" style="--d:.85s">
						<Image src={fotoEstudio} alt="" width={160} loading="eager" />
						<Image src={fotoRegata} alt="" width={160} loading="eager" />
						<Image src={fotoTattoo} alt="" width={160} loading="eager" />
					</span>
				</span>
				<span class="line" aria-hidden="true">
					<span class="w"><span class="amp" style="--d:.55s">e</span></span>
					<span class="pill pill-solo pill-ring" style="--d:1s">
						<Image src={fotoBlazer} alt="" width={200} loading="eager" />
					</span>
					<span class="w w-marker">
						<span class="gradient-text" style="--d:.65s">performance.</span>
						<svg class="marker" viewBox="0 0 300 20" preserveAspectRatio="none"><path d="M3 14 C 70 4, 160 4, 297 11" /></svg>
					</span>
				</span>
			</h1>

			<div class="sub-row">
				<p class="lede">
					Estratégia, casting, campanhas e conteúdo para aproximar marcas das pessoas que <strong>fazem a diferença</strong>.
				</p>
				<a href="#contato" class="cta">
					<span class="beam-ring">
						<span class="cta-inner">
							<span class="cta-shine" aria-hidden="true"></span>
							<span class="cta-label">Vamos conversar</span>
							<span class="cta-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
							</span>
						</span>
					</span>
				</a>
			</div>
		</div>

		<!-- ===================== PALCO ===================== -->
		<div class="stage" aria-label="Casting ADR">
			{cards.map((c) => (
				<div class={`slot ${c.cls}`} style={`--x:${c.x};--y:${c.y};--depth:${c.depth}`}>
					<article class="card" style={`--d:${c.d};--r:${c.r}`}>
						<div class="card-float">
							<Image src={c.img} alt={c.alt} width={420} style={`object-position:${c.pos}`} />
							<div class="card-shade"></div>
							<div class="card-info">
								<span class="chip">Casting ADR</span>
								<strong class="card-word">{c.word}</strong>
								<span class="card-line">{c.line}</span>
							</div>
							<span class="card-btn" aria-hidden="true">
								<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M7 17 17 7M8 7h9v9" /></svg>
							</span>
						</div>
					</article>
				</div>
			))}

			<!-- celular central -->
			<div class="slot slot-phone" style="--x:0%;--y:-140px;--depth:8">
				<div class="phone" style="--d:.8s">
					<div class="phone-screen">
						<Image src={fotoBlazer} alt="Talento do casting ADR de terno em frente a um carro" width={640} loading="eager" class="phone-img" />
						<div class="phone-shade"></div>
						<div class="phone-status" aria-hidden="true">
							<span>9:41</span>
							<span class="island"></span>
							<span class="status-icons"><i></i><i></i><i></i></span>
						</div>
						<div class="story-bars" aria-hidden="true"><i class="on"></i><i></i><i></i><i></i></div>
						<div class="phone-top" aria-hidden="true">
							<span class="logo-mark logo-mark-white"></span>
							<span class="menu"><i></i><i></i></span>
						</div>
						<div class="phone-info">
							<span class="chip">Nova campanha</span>
							<strong class="phone-word">Campanhas</strong>
							<span class="card-line">Marca × criador, do briefing à entrega</span>
						</div>
						<span class="phone-btn" aria-hidden="true">
							<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12Z" /><path d="M8.5 11.5h7M8.5 14.5h4" /></svg>
						</span>
					</div>
				</div>

				<div class="toast" aria-hidden="true">
					<span class="toast-ico">
						<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-10" /></svg>
					</span>
					<span><b>Match perfeito</b><small>marca × criador</small></span>
				</div>
			</div>
		</div>

		<!-- ===================== FITAS ===================== -->
		<div class="ribbons" aria-hidden="true">
			<div class="ribbon ribbon-back">
				<div class="ribbon-track">
					{[0, 1].map(() => (
						<div class="ribbon-content">
							{ribbon.concat(ribbon).map((r) => (<><span>{r}</span><i class="star">✦</i></>))}
						</div>
					))}
				</div>
			</div>
			<div class="ribbon ribbon-front">
				<div class="ribbon-track">
					{[0, 1].map(() => (
						<div class="ribbon-content">
							{ribbon.concat(ribbon).map((r) => (<><span>{r}</span><i class="dot"></i></>))}
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<Casting />
	<Spotlight />
</Layout>

<script>
	// Parallax do palco + lanterna do cursor (desativados com reduced motion / touch)
	const hero = document.querySelector<HTMLElement>('[data-hero]');
	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const fine = window.matchMedia('(pointer: fine)').matches;

	if (hero && !reduce && fine) {
		let raf = 0;
		let tx = 0, ty = 0, cx = 0, cy = 0;
		hero.addEventListener('pointermove', (e) => {
			const r = hero.getBoundingClientRect();
			tx = (e.clientX - r.left) / r.width - 0.5;
			ty = (e.clientY - r.top) / r.height - 0.5;
			hero.style.setProperty('--mouse-x', `${e.clientX - r.left}px`);
			hero.style.setProperty('--mouse-y', `${e.clientY - r.top}px`);
			if (!raf) raf = requestAnimationFrame(tick);
		});
		hero.addEventListener('pointerleave', () => { tx = 0; ty = 0; if (!raf) raf = requestAnimationFrame(tick); });

		function tick() {
			cx += (tx - cx) * 0.08;
			cy += (ty - cy) * 0.08;
			hero!.style.setProperty('--mx', cx.toFixed(4));
			hero!.style.setProperty('--my', cy.toFixed(4));
			raf = Math.abs(tx - cx) + Math.abs(ty - cy) > 0.0005 ? requestAnimationFrame(tick) : 0;
		}
	}
</script>

<style is:global>
	:root {
		/* ADR — paleta (design_system.html) */
		--blue: #0d4bf7;
		--navy: #16006d;
		--mint: #5ae6cb;
		--indigo: #3843d0;
		--deep: #100057;
		--ink: #11112b;
		--muted: #65657a;
		--soft: #f3f5ff;
		--line: #dfe3f5;
		--periwinkle: #dce4ff;
		--lavender: #b8c4ff;

		--font-sans: "Inter", "Inter Fallback", Arial, "Helvetica Neue", sans-serif;
		--font-mono: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;

		--radius-lg: 22px;
		--radius-xl: 32px;
		--shadow-2: 0 18px 45px #16006d1a;
		--rf-card-shadow: 0 30px 70px #07032861;
		--ring-story: linear-gradient(135deg, var(--mint) 0%, var(--blue) 55%, var(--indigo) 100%);

		--ease-out: cubic-bezier(.2, .8, .2, 1);
		--ease-expo: cubic-bezier(0.16, 1, 0.3, 1);
	}

	body {
		font-family: var(--font-sans);
		background: #fff;
		color: var(--ink);
		overflow-x: hidden;
		font-feature-settings: "ss01", "cv11";
		-webkit-font-smoothing: antialiased;
	}

	::selection { background: var(--navy); color: var(--mint); }
</style>

<style>
	/* =========================================================
	   KEYFRAMES (design_system.html)
	   ========================================================= */
	@keyframes animationIn { 0% { opacity: 0; transform: translateY(30px); filter: blur(10px); } 100% { opacity: 1; transform: none; filter: blur(0); } }
	@keyframes textSlide { 0% { transform: translateY(110%); opacity: 0; } 100% { transform: translateY(0); opacity: 1; } }
	@keyframes aurora-drift { 0% { transform: translate3d(0, 0, 0) scale(1) rotate(0deg); } 50% { transform: translate3d(7%, -6%, 0) scale(1.15) rotate(20deg); } 100% { transform: translate3d(-5%, 6%, 0) scale(.92) rotate(-10deg); } }
	@keyframes beam-fall { from { transform: translateY(-200px); } to { transform: translateY(110vh); } }
	@keyframes gradient-pan { to { background-position: 200% 50%; } }
	@keyframes ghost-sweep { 0% { background-position: 160% 0; } 100% { background-position: -60% 0; } }
	@keyframes outline-fill { 0%, 35% { background-position: 100% 0; } 55%, 80% { background-position: 0 0; } 100% { background-position: -100% 0; } }
	@keyframes draw { to { stroke-dashoffset: 0; } }
	@keyframes rf-float { 0%, to { translate: 0; } 50% { translate: 0 -10px; } }
	@keyframes rf-pulse { 0% { box-shadow: 0 0 0 0 #5ae6cbb3; } 70% { box-shadow: 0 0 0 8px #5ae6cb00; } to { box-shadow: 0 0 #5ae6cb00; } }
	@keyframes rf-glow { 0%, to { box-shadow: 0 0 0 0 #5ae6cb66, 0 8px 22px #5ae6cb40; } 50% { box-shadow: 0 0 0 7px #5ae6cb00, 0 8px 28px #5ae6cb80; } }
	@keyframes marquee { to { transform: translateX(-50%); } }
	@keyframes marquee-reverse { from { transform: translateX(-50%); } to { transform: translateX(0); } }
	@keyframes shimmer { from { transform: translateX(-100%) skewX(-15deg); } to { transform: translateX(200%) skewX(-15deg); } }
	@keyframes conic-spin { to { --angle: 360deg; } }
	@keyframes pill-in { 0% { opacity: 0; transform: scale(.4) rotate(-12deg); filter: blur(8px); } 100% { opacity: 1; transform: none; filter: blur(0); } }
	@keyframes card-in { 0% { opacity: 0; transform: translateY(140px) rotate(0deg) scale(.92); filter: blur(12px); } 100% { opacity: 1; transform: rotate(var(--r, 0deg)); filter: blur(0); } }
	@keyframes phone-in { 0% { opacity: 0; transform: translateY(180px) scale(.94); filter: blur(14px); } 100% { opacity: 1; transform: none; filter: blur(0); } }
	@keyframes ken-burns { 0% { transform: scale(1.04) translateY(0); } 100% { transform: scale(1.14) translateY(-2%); } }
	@keyframes story { 0% { transform: scaleX(0); } 100% { transform: scaleX(1); } }
	@keyframes toast-in { 0% { opacity: 0; transform: translateY(16px) scale(.96); filter: blur(8px); } 100% { opacity: 1; transform: none; filter: blur(0); } }
	@keyframes ribbon-in { from { opacity: 0; transform: translateY(60px) rotate(var(--rot)); } to { opacity: 1; transform: rotate(var(--rot)); } }

	@property --angle { syntax: "<angle>"; initial-value: 0deg; inherits: false; }

	.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

	/* =========================================================
	   HERO SHELL
	   ========================================================= */
	.hero {
		--mx: 0;
		--my: 0;
		position: relative;
		isolation: isolate;
		overflow: hidden;
		height: 100svh;
		min-height: 640px;
		display: flex;
		flex-direction: column;
		background: #fff;
	}

	/* lanterna do cursor */
	.hero::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		background: radial-gradient(520px circle at var(--mouse-x, 50%) var(--mouse-y, -20%), rgba(13, 75, 247, .07), transparent 60%);
	}

	.hero-bg { position: absolute; inset: 0; z-index: -2; pointer-events: none; overflow: hidden; }

	.grid-bg {
		position: absolute;
		inset: 0;
		background-size: 40px 40px;
		background-image:
			linear-gradient(to right, rgba(22, 0, 109, .045) 1px, transparent 1px),
			linear-gradient(to bottom, rgba(22, 0, 109, .045) 1px, transparent 1px);
		-webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 0%, #000 30%, transparent 75%);
		mask-image: radial-gradient(ellipse 80% 70% at 50% 0%, #000 30%, transparent 75%);
	}

	.aurora { position: absolute; border-radius: 50%; filter: blur(80px); animation: aurora-drift 20s ease-in-out infinite alternate; will-change: transform; }
	.aurora-blue { background: radial-gradient(circle, #3158ff 0, transparent 65%); }
	.aurora-mint { background: radial-gradient(circle, #5ae6cb 0, transparent 65%); }
	.aurora-lavender { background: radial-gradient(circle, #b8c4ff 0, transparent 65%); }
	.a1 { width: 46rem; height: 46rem; top: -20rem; right: -14rem; opacity: .2; }
	.a2 { width: 40rem; height: 40rem; bottom: -12rem; left: -14rem; opacity: .32; animation-delay: -6s; }
	.a3 { width: 34rem; height: 34rem; bottom: 4rem; left: 38%; opacity: .3; animation-delay: -12s; }

	.grid-beam { position: absolute; top: 0; width: 1px; height: 180px; background: linear-gradient(to bottom, transparent, rgba(13, 75, 247, .7), rgba(90, 230, 203, .9)); animation: beam-fall 9s linear infinite; opacity: .5; }
	.grid-beam::after { content: ""; position: absolute; bottom: -2px; left: -2px; width: 5px; height: 5px; border-radius: 50%; background: var(--mint); box-shadow: 0 0 12px 3px rgba(90, 230, 203, .8); }

	.scribble { position: absolute; inset: 0; width: 100%; height: 100%; }
	.scribble path { stroke: rgba(22, 0, 109, .16); stroke-width: 1.1; stroke-dasharray: 2600; stroke-dashoffset: 2600; animation: draw 4.5s var(--ease-expo) forwards; vector-effect: non-scaling-stroke; }
	.scribble .d2 { animation-delay: .5s; stroke: rgba(13, 75, 247, .18); }
	.scribble .d3 { animation-delay: .9s; stroke: rgba(90, 230, 203, .45); }

	.ghost-text {
		position: absolute;
		left: 50%;
		bottom: -7vw;
		translate: -50% 0;
		font-size: 38vw;
		white-space: nowrap;
		font-weight: 900;
		font-style: italic;
		letter-spacing: -.08em;
		line-height: .8;
		color: transparent;
		-webkit-text-stroke: 1px rgba(22, 0, 109, .07);
		user-select: none;
	}
	.ghost-text::after {
		content: attr(data-text);
		position: absolute;
		inset: 0;
		-webkit-text-stroke: 0;
		background: linear-gradient(100deg, transparent 42%, rgba(13, 75, 247, .16) 48%, rgba(90, 230, 203, .32) 52%, transparent 58%);
		background-size: 300% 100%;
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		animation: ghost-sweep 8s linear infinite;
	}

	/* =========================================================
	   NAV
	   ========================================================= */
	.nav {
		position: relative;
		z-index: 20;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		width: min(1280px, calc(100% - 40px));
		margin: 14px auto 0;
		padding: 7px 7px 7px 20px;
		border-radius: 999px;
		background: rgba(255, 255, 255, .55);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
		border: 1px solid rgba(223, 227, 245, .8);
		box-shadow: 0 8px 22px #16006d0b;
		animation: animationIn .8s ease-out .05s both;
	}

	.nav-meta, .badge-mono {
		display: inline-flex;
		align-items: center;
		gap: 9px;
		font-family: var(--font-mono);
		font-size: 10.5px;
		font-weight: 500;
		letter-spacing: .14em;
		text-transform: uppercase;
		color: var(--navy);
	}

	.nav-left { display: flex; align-items: center; gap: 16px; }
	.nav-brand { display: flex; align-items: center; padding-right: 16px; border-right: 1px solid var(--line); }
	.logo-mark.logo-mark-nav { width: 62px; background: var(--navy); animation: none; transition: background .3s; }
	.nav-brand:hover .logo-mark-nav { background: var(--blue); }

	.live-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--mint); animation: rf-pulse 2s infinite; }

	.nav-links { display: flex; gap: 30px; }
	.nav-links a { position: relative; color: var(--navy); font-weight: 700; font-size: 14px; text-decoration: none; letter-spacing: -.01em; }
	.nav-links a::after { content: ""; position: absolute; left: 0; bottom: -5px; height: 2px; width: 100%; background: var(--ring-story); transform: scaleX(0); transform-origin: left; transition: transform .5s var(--ease-expo); border-radius: 2px; }
	.nav-links a:hover::after { transform: scaleX(1); }

	.button { display: inline-flex; align-items: center; justify-content: center; gap: 9px; border: 0; border-radius: 999px; padding: 12px 18px; font-size: 14px; font-weight: 800; letter-spacing: -.01em; text-decoration: none; transition: transform .2s var(--ease-out), background .2s, color .2s; cursor: pointer; }
