	}
	.phone-screen { position: relative; height: 100%; border-radius: 38px; overflow: hidden; background: #000; }
	.phone-screen > :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 18%; animation: phone-pan 14s ease-in-out infinite alternate; }
	.phone-shade { position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(0, 0, 0, .45), transparent 22%, transparent 48%, rgba(16, 0, 87, .92)); }
	.phone-status { position: absolute; top: 12px; left: 22px; right: 22px; display: flex; align-items: center; justify-content: space-between; color: #fff; font-size: 12px; font-weight: 700; }
	.island { position: absolute; left: 50%; top: -2px; width: 34%; height: 24px; margin-left: -17%; border-radius: 999px; background: #000; }
	.bars { display: flex; gap: 2px; align-items: flex-end; }
	.bars i { width: 3px; background: #fff; border-radius: 1px; }
	.bars i:nth-child(1) { height: 5px; } .bars i:nth-child(2) { height: 7px; } .bars i:nth-child(3) { height: 9px; }
	.phone-top { position: absolute; top: 50px; left: 20px; right: 20px; display: flex; align-items: center; justify-content: space-between; }
	.phone-logo { width: 64px; aspect-ratio: 384 / 136; background: #fff; -webkit-mask: var(--logo) center / contain no-repeat; mask: var(--logo) center / contain no-repeat; }
	.phone-menu { display: flex; flex-direction: column; gap: 4px; align-items: flex-end; }
	.phone-menu i { display: block; height: 2px; width: 18px; background: var(--mint); border-radius: 2px; }
	.phone-menu i:last-child { width: 11px; }
	.phone-body { position: absolute; left: 18px; right: 18px; bottom: 20px; color: #fff; display: flex; flex-direction: column; align-items: flex-start; }
	.phone-body strong { font-size: clamp(32px, 3.2vw, 44px); font-weight: 850; font-style: italic; letter-spacing: -.06em; line-height: .95; text-transform: uppercase; margin-top: 10px; }
	.phone-body .tag { font-size: 9.5px; padding: 5px 10px; }
	.phone-body .tag .live-dot { width: 6px; height: 6px; background: var(--navy); animation: none; }
	.phone-actions { display: flex; align-items: center; gap: 8px; width: 100%; margin-top: 16px; }
	.pa { display: grid; place-items: center; height: 42px; border-radius: 999px; }
	.pa-x { width: 42px; background: rgba(255, 255, 255, .14); border: 1px solid rgba(255, 255, 255, .28); backdrop-filter: blur(8px); }
	.pa-go { flex: 1; display: flex; justify-content: center; gap: 8px; align-items: center; background: var(--mint); color: var(--navy); font-weight: 800; font-size: 14px; animation: rf-glow 2.8s ease-in-out infinite; }

	.rf-chip { position: absolute; z-index: 6; display: inline-flex; align-items: center; gap: 9px; padding: 7px 14px 7px 7px; border-radius: 999px; background: #fff; box-shadow: 0 14px 34px rgba(7, 3, 40, .22); font-size: 13px; font-weight: 800; color: var(--ink); white-space: nowrap; animation: rf-float 6s ease-in-out -1s infinite; }
	.chip-ico { width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; color: #fff; }
	.chip-ig { background: linear-gradient(135deg, #fa7e1e, #d62976, #962fbf); }
	.chip-heart { background: var(--navy); color: var(--mint); }
	.chip-1 { top: 22%; left: -34%; }
	.chip-2 { top: 52%; right: -36%; animation-delay: -3s; }

	/* process card */
	.pcard {
		position: relative;
		border-radius: var(--radius-lg);
		padding: 20px 18px 18px;
		color: #fff;
		background: radial-gradient(circle at 85% 0%, rgba(49, 88, 255, .8), transparent 55%), var(--hero-gradient);
		box-shadow: var(--rf-card-shadow);
		overflow: hidden;
		animation: rf-float 7.5s ease-in-out -4s infinite;
	}
	.pcard::before { content: ""; position: absolute; inset: 0; background-image: radial-gradient(#ffffff1f 1px, transparent 1px); background-size: 18px 18px; -webkit-mask-image: linear-gradient(160deg, #000, transparent 70%); mask-image: linear-gradient(160deg, #000, transparent 70%); }
	.pcard-head { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-bottom: 14px; border-bottom: 1px solid rgba(255, 255, 255, .16); }
	.pcard-logo { width: 58px; aspect-ratio: 384 / 136; background: #fff; -webkit-mask: var(--logo) center / contain no-repeat; mask: var(--logo) center / contain no-repeat; }
	.pcard-kicker { font-family: var(--font-mono); font-size: 9px; letter-spacing: .16em; text-transform: uppercase; color: var(--lavender); text-align: right; line-height: 1.5; }
	.pcard ol { position: relative; list-style: none; margin: 10px 0 0; padding: 0; }
	.pcard li { display: flex; align-items: center; gap: 12px; padding: 10px 10px; margin: 0 -10px; border-radius: 12px; transition: background .5s var(--ease-expo); }
	.pcard .n { font-family: var(--font-mono); font-size: 10px; color: var(--lavender); opacity: .7; }
	.pcard .s { flex: 1; font-weight: 800; font-size: 16px; letter-spacing: -.03em; color: rgba(255, 255, 255, .55); transition: color .5s; }
	.pcard .ck { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; border: 1px solid rgba(255, 255, 255, .25); color: transparent; transition: all .5s var(--ease-expo); }
	.pcard li.done .s { color: rgba(255, 255, 255, .85); }
	.pcard li.done .ck { background: rgba(90, 230, 203, .2); border-color: transparent; color: var(--mint); }
	.pcard li.on { background: rgba(255, 255, 255, .1); }
	.pcard li.on .s { color: #fff; }
	.pcard li.on .ck { background: var(--mint); border-color: var(--mint); color: var(--navy); animation: rf-pulse 1.8s infinite; }
	.pcard-bar { position: relative; height: 3px; margin-top: 12px; border-radius: 3px; background: rgba(255, 255, 255, .14); overflow: hidden; }
	.pcard-bar span { position: absolute; inset: 0; transform-origin: left; transform: scaleX(var(--p, .25)); background: linear-gradient(90deg, var(--mint), #fff); transition: transform .9s var(--ease-expo); border-radius: inherit; }

	/* ============ FAIXA (marquee) ============ */
	.band {
		position: relative;
		z-index: 6;
		margin-top: auto;
		background: var(--mint);
		color: var(--navy);
		overflow: hidden;
		border-top: 1px solid rgba(22, 0, 109, .08);
	}
	.band-track { display: flex; width: max-content; animation: marquee 38s linear infinite; }
	.band:hover .band-track { animation-play-state: paused; }
	.band-content { display: flex; align-items: center; gap: 26px; padding: 14px 13px; }
	.band-content span { font-size: clamp(18px, 1.8vw, 24px); font-weight: 850; font-style: italic; text-transform: uppercase; letter-spacing: -.04em; white-space: nowrap; }
	.band-content .star { font-style: normal; font-size: 14px; color: var(--blue); }

	@keyframes phone-pan { from { transform: scale(1.04) translateY(0); } to { transform: scale(1.12) translateY(-2%); } }

	/* ============ RESPONSIVO ============ */
	@media (max-width: 1100px) {
		.fan-a { --x: -2% !important; }
		.fan-d { --x: 80% !important; }
		.chip-1 { left: -22%; }
		.chip-2 { right: -24%; }
	}
	@media (max-width: 860px) {
		.hero { padding-top: 104px; }
		.nav-links { display: none; }
		.hero-sub { grid-template-columns: 1fr; text-align: center; gap: 22px; }
		.hero-sub p { margin: 0 auto; }
		.cta-row { justify-content: center; flex-wrap: wrap; }
		.fan-a, .fan-d { display: none; }
		.stage { height: 540px; margin-top: 36px; }
		.fan-b { --x: 3% !important; --y: 90px !important; }
		.fan-c { --x: 60% !important; --y: 110px !important; }
		.chip-1 { left: -18%; top: 16%; }
		.chip-2 { right: -18%; top: 60%; }
	}
	@media (max-width: 560px) {
		.nav { padding: 12px 16px 0; }
		.nav .button-small { padding: 11px 14px; font-size: 13px; }
		.hero-copy { padding: 0 16px; }
		.brand-row { gap: 12px; }
		.brand-tag { font-size: 9.5px; letter-spacing: .12em; padding: 7px 10px; }
		.headline { font-size: clamp(30px, 10.4vw, 48px); margin-top: 22px; }
		.line { gap: .16em; }
		.stage { height: 470px; padding: 0 16px; }
		.fan-phone { --w: 220px; }
		.fan-b { --w: 132px; --x: -8% !important; --y: 120px !important; }
		.fan-c { --w: 128px; --x: 72% !important; --y: 140px !important; }
		.tcard-body strong { font-size: 16px; }
		.tcard-body .meta, .tcard-act { display: none; }
		.chip-1 { left: -6%; top: 12%; }
		.chip-2 { right: -8%; top: 64%; }
		.rf-chip { font-size: 11.5px; padding: 6px 12px 6px 6px; }
		.chip-ico { width: 26px; height: 26px; }
	}

	@media (prefers-reduced-motion: reduce) {
		.hero *, .hero *::before, .hero *::after { animation: none !important; transition-duration: .01ms !important; transition-delay: 0s !important; }
		.scribble .draw, .marker path { stroke-dashoffset: 0; }
	}
</style>

<script>
	const hero = document.querySelector<HTMLElement>('[data-hero]');
	if (hero) {
		const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
		const start = () => requestAnimationFrame(() => hero.classList.add('is-ready'));
		(document.fonts?.ready ?? Promise.resolve()).then(start);
		setTimeout(start, 1200);

		const stage = hero.querySelector<HTMLElement>('[data-stage]');
		let tx = 0, ty = 0, cx = 0, cy = 0, sy = 0, csy = 0;

		if (!reduce && stage) {
			const fine = matchMedia('(pointer: fine)').matches;
			if (fine) {
				hero.addEventListener('pointermove', (e) => {
					const r = hero.getBoundingClientRect();
					tx = ((e.clientX - r.left) / r.width - .5) * 2;
					ty = ((e.clientY - r.top) / r.height - .5) * 2;
					hero.style.setProperty('--mouse-x', `${e.clientX - r.left}px`);
					hero.style.setProperty('--mouse-y', `${e.clientY - r.top}px`);
				});
				hero.addEventListener('pointerleave', () => { tx = 0; ty = 0; });
			}
			const onScroll = () => { sy = Math.min(1, Math.max(0, window.scrollY / (hero.offsetHeight * .8))); };
			addEventListener('scroll', onScroll, { passive: true });
			onScroll();

			const tick = () => {
				cx += (tx - cx) * .06; cy += (ty - cy) * .06; csy += (sy - csy) * .1;
				stage.style.setProperty('--mx', cx.toFixed(4));
				stage.style.setProperty('--my', cy.toFixed(4));
				stage.style.setProperty('--sy', csy.toFixed(4));
				requestAnimationFrame(tick);
			};
			tick();

			// CTA magnético
			hero.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((el) => {
				el.addEventListener('pointermove', (e) => {
					const r = el.getBoundingClientRect();
					el.style.transform = `translate(${(e.clientX - r.left - r.width / 2) * .18}px, ${(e.clientY - r.top - r.height / 2) * .3}px)`;
				});
				el.addEventListener('pointerleave', () => { el.style.transform = ''; });
			});
		}

		// Card de processo: percorre as etapas
		const card = hero.querySelector<HTMLElement>('[data-steps]');
		if (card) {
			const items = [...card.querySelectorAll('li')];
			const bar = card.querySelector<HTMLElement>('.pcard-bar span');
			let i = 0;
			const paint = () => {
				items.forEach((li, k) => { li.classList.toggle('on', k === i); li.classList.toggle('done', k < i); });
				bar?.style.setProperty('--p', String((i + 1) / items.length));
			};
			paint();
			if (!reduce) setInterval(() => { i = (i + 1) % items.length; paint(); }, 1900);
		}
	}
</script>
