---
/**
 * Segunda dobra — Casting exclusivo ADR
 * Dados reais extraídos de src/assets/adragencia.com.br/index.html
 * (somente os talentos que têm foto baixada localmente).
 */
import { Image } from 'astro:assets';

import logo from '../assets/hero/adr-logo.png';
import { talents, socialIcons as icons } from '../data/talents';

const logoVar = `--logo:url("${logo.src}")`;
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="casting" id="casting" data-casting style={logoVar} aria-roledescription="carrossel" aria-label="Casting exclusivo ADR">
	<!-- ===================== FUNDO ===================== -->
	<div class="c-bg" aria-hidden="true">
		<div class="c-grid"></div>
		<div class="c-glow"></div>
		<div class="aurora-x aurora-blue x1"></div>
		<div class="aurora-x aurora-mint x2"></div>
		<div class="aurora-x aurora-violet x3"></div>
		<div class="c-beam" style="left:14%;animation-delay:-3s"></div>
		<div class="c-beam" style="left:58%;animation-delay:-7s;animation-duration:12s"></div>
		<div class="c-beam" style="left:86%;animation-delay:-1s"></div>
	</div>

	<!-- ===================== CABEÇALHO ===================== -->
	<header class="c-head" data-reveal>
		<span class="c-eyebrow"><span class="c-live"></span>02 — Casting exclusivo</span>
		<h2 class="c-title">
			<span class="c-tw"><span>Quem está no</span></span>
			<span class="c-tw"><span class="c-grad">casting ADR</span></span>
		</h2>
		<div class="c-meta">
		<p class="c-sub">Toque em um talento para ver perfil, audiência e mídia kit.</p>
		<span class="c-meta-sep" aria-hidden="true"></span>
		<dl class="c-stats">
			<div><dt>Talentos no casting exclusivo</dt><dd data-count="19">19</dd></div>
			<span class="c-stats-sep" aria-hidden="true"></span>
			<div><dt>Seguidores somados</dt><dd data-count="185.6" data-decimals="1" data-suffix=" mi">185,6 mi</dd></div>
		</dl>
		</div>
	</header>

	<!-- ===================== PALCO ===================== -->
	<div class="c-stage" data-reveal>
		<!-- nome gigante vazado ao fundo -->
		<div class="c-names" aria-hidden="true">
			{talents.map((t, i) => (
				<div class={`c-name-run ${i === 0 ? 'is-active' : ''}`} data-i={i}>
					<div class="c-name-track">
						{[0, 1].map(() => (
							<span>{t.name}<i>✦</i>{t.name}<i>✦</i>{t.name}<i>✦</i></span>
						))}
					</div>
				</div>
			))}
		</div>

		<!-- anel 3D de cartões -->
		<div class="c-ring">
			{talents.map((t, i) => (
				<button class="c-card" type="button" data-go={i} style={`--d:${i};--ad:${i}`} aria-label={`Ver ${t.name}`} tabindex="-1">
					<Image src={t.img} alt="" width={360} style={`object-position:${t.pos}`} />
					<span class="c-card-shade"></span>
					<span class="c-card-cap">
						<strong>{t.name}</strong>
						<small>{t.totalLabel} seguidores</small>
					</span>
				</button>
			))}
		</div>

		<!-- celular / moldura -->
		<div class="c-phone-wrap">
			<button class="c-nav c-prev" type="button" data-prev aria-label="Talento anterior">
				<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
			</button>
			<button class="c-nav c-next" type="button" data-next aria-label="Próximo talento">
				<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
			</button>

			<!-- cartão flutuante: perfil -->
			<div class="c-float c-float-l" aria-hidden="true">
				{talents.map((t, i) => (
					<div class={`c-float-slide ${i === 0 ? 'is-active' : ''}`} data-i={i}>
						<span class="c-float-k">Perfil</span>
						<span class="c-loc">
							<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.4" /></svg>
							{t.location}
						</span>
						<p class="c-quote">“{t.tagline}”</p>
						<div class="c-niches">{t.niches.map((n) => <span>{n}</span>)}</div>
					</div>
				))}
			</div>

			<!-- cartão flutuante: audiência -->
			<div class="c-float c-float-r" aria-hidden="true">
				{talents.map((t, i) => (
					<div class={`c-float-slide ${i === 0 ? 'is-active' : ''}`} data-i={i}>
						<span class="c-float-k">Audiência por rede</span>
						<ul class="c-bars">
							{t.metrics.map((m, k) => (
								<li style={`--w:${t.bars[k]}%;--k:${k}`}>
									<span class="c-bar-ico" set:html={icons[m.network]} />
									<span class="c-bar-track"><span class="c-bar-fill"></span></span>
									<b>{m.value}</b>
								</li>
							))}
						</ul>
					</div>
				))}
			</div>

			<div class="c-phone">
				<span class="c-btn-side c-btn-a" aria-hidden="true"></span>
				<span class="c-btn-side c-btn-b" aria-hidden="true"></span>
				<span class="c-btn-side c-btn-c" aria-hidden="true"></span>
				<div class="c-screen" data-swipe>
					{talents.map((t, i) => (
						<article
							class={`c-slide ${i === 0 ? 'is-active' : ''}`}
							data-i={i}
							aria-roledescription="slide"
							aria-label={`${pad(i + 1)} de ${pad(talents.length)}: ${t.name}`}
							aria-hidden={i === 0 ? 'false' : 'true'}
						>
							<div class="c-photo">
								<Image src={t.img} alt={`${t.name}, talento do casting ADR`} width={720} loading={i < 2 ? 'eager' : 'lazy'} style={`object-position:${t.pos}`} />
							</div>
							<div class="c-shade"></div>

							<div class="c-panel">
								<span class="c-pill">Casting exclusivo ADR</span>
								<div class="c-name-row">
									<h3 class="c-name"><span>{t.name}</span></h3>
									<span class="c-verified" title="Talento verificado ADR">
										<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
									</span>
									<a class="c-up" href={t.socials.Instagram} target="_blank" rel="noopener" aria-label={`Abrir o Instagram de ${t.name}`} tabindex={i === 0 ? 0 : -1}>
										<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M6 11l6-6 6 6" /></svg>
									</a>
								</div>
								<p class="c-reach">
									<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h10M4 17h6M18 7h2M14 17h6" /><circle cx="16" cy="7" r="2" /><circle cx="12" cy="17" r="2" /></svg>
									<b data-total={t.total}>{t.totalLabel}</b> seguidores somados
								</p>
								<ul class="c-chips">
									{t.metrics.map((m, k) => (
										<li style={`--k:${k}`}>
											<a href={m.url} target="_blank" rel="noopener" tabindex={i === 0 ? 0 : -1} aria-label={`${t.name} no ${m.network}: ${m.value} seguidores`}>
												<span class="c-chip-ico" set:html={icons[m.network]} />
												{m.value}
												<svg class="c-chk" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
											</a>
										</li>
									))}
								</ul>
							</div>
						</article>
					))}

					<!-- UI do sistema sobre as fotos -->
					<div class="c-ui" aria-hidden="true">
						<div class="c-status"><span>9:41</span><span class="c-island"></span><span class="c-sig"><i></i><i></i><i></i><i></i></span></div>
						<div class="c-stories">
							{talents.map((_, i) => <i class={i === 0 ? 'is-active' : ''} data-i={i}><b></b></i>)}
						</div>
						<div class="c-topbar">
							<span class="c-logo"></span>
							<span class="c-handle">
								{talents.map((t, i) => <span class={i === 0 ? 'is-active' : ''} data-i={i}>{t.handle}</span>)}
							</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- ===================== CONTROLES ===================== -->
	<div class="c-foot" data-reveal>
		<div class="c-counter" aria-hidden="true">
			<span class="c-count-now">
				{talents.map((_, i) => <span class={i === 0 ? 'is-active' : ''} data-i={i}>{pad(i + 1)}</span>)}
			</span>
			<span class="c-count-line"><span></span></span>
			<span class="c-count-total">{pad(talents.length)}</span>
		</div>
		<div class="c-dots" role="tablist" aria-label="Escolher talento">
			{talents.map((t, i) => (
				<button type="button" role="tab" class={i === 0 ? 'is-active' : ''} data-go={i} aria-selected={i === 0 ? 'true' : 'false'} aria-label={t.name}>
					<Image src={t.img} alt="" width={72} style={`object-position:${t.pos}`} />
				</button>
			))}
		</div>
		<a class="c-link" href="https://adragencia.com.br/casting" target="_blank" rel="noopener">
			Ver o casting completo
			<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M7 17 17 7M8 7h9v9" /></svg>
		</a>
	</div>

	<p class="sr-only" aria-live="polite" data-live></p>
</section>

<script>
	const root = document.querySelector<HTMLElement>('[data-casting]');
	if (root) {
		const slides = [...root.querySelectorAll<HTMLElement>('.c-slide')];
		const n = slides.length;
		const cards = [...root.querySelectorAll<HTMLElement>('.c-card')];
		const synced = [...root.querySelectorAll<HTMLElement>('.c-name-run, .c-float-slide, .c-stories i, .c-handle span, .c-count-now span')];
		const dots = [...root.querySelectorAll<HTMLButtonElement>('.c-dots button')];
		const live = root.querySelector<HTMLElement>('[data-live]');
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const DURATION = 7000;

		let current = 0;
		let timer = 0;
		let inView = false;
		let hovered = false;

		const wrap = (d: number) => {
			let x = ((d % n) + n) % n;
			if (x > n / 2) x -= n;
			return x;
		};

		function layoutRing() {
			cards.forEach((c, i) => {
				const d = wrap(i - current);
				c.style.setProperty('--d', String(d));
				c.style.setProperty('--ad', String(Math.abs(d)));
				c.classList.toggle('is-hidden', d === 0 || Math.abs(d) > 2);
			});
		}

		function countUp(el: HTMLElement) {
			const total = Number(el.dataset.total || 0);
			if (reduce || !total) return;
			const isMi = total >= 1e6;
			const start = performance.now();
			const dur = 1100;
			const step = (now: number) => {
				const p = Math.min(1, (now - start) / dur);
				const e = 1 - Math.pow(1 - p, 4);
				const v = total * e;
				el.textContent = isMi ? `${(v / 1e6).toFixed(1).replace('.', ',')} mi` : `${Math.round(v / 1e3)} mil`;
				if (p < 1) requestAnimationFrame(step);
				else el.textContent = isMi ? `${(total / 1e6).toFixed(1).replace('.', ',').replace(',0', '')} mi` : `${Math.round(total / 1e3)} mil`;
			};
			requestAnimationFrame(step);
		}

		function go(i: number, dir = 1) {
			const next = ((i % n) + n) % n;
			if (next === current) return;
			root!.style.setProperty('--dir', String(dir));
			root!.classList.toggle('is-back', dir < 0);
			slides[current].classList.remove('is-active');
			slides[current].classList.add('is-leaving');
			const leaving = slides[current];
			setTimeout(() => leaving.classList.remove('is-leaving'), 1100);
			slides[current].setAttribute('aria-hidden', 'true');
			slides[current].querySelectorAll('a').forEach((a) => a.setAttribute('tabindex', '-1'));

			current = next;
			const s = slides[current];
			s.classList.add('is-active');
			s.setAttribute('aria-hidden', 'false');
			s.querySelectorAll('a').forEach((a) => a.setAttribute('tabindex', '0'));
			const totalEl = s.querySelector<HTMLElement>('[data-total]');
			if (totalEl) countUp(totalEl);

			synced.forEach((el) => {
				const idx = Number(el.dataset.i);
				el.classList.toggle('is-active', idx === current);
				el.classList.toggle('is-done', el.matches('.c-stories i') && idx < current);
			});
			dots.forEach((d, k) => {
				d.classList.toggle('is-active', k === current);
				d.setAttribute('aria-selected', k === current ? 'true' : 'false');
			});
			layoutRing();
			if (live) live.textContent = `${s.getAttribute('aria-label')}`;
			window.dispatchEvent(new CustomEvent('adr:talent', { detail: { index: current } }));
			restart();
		}

		function restart() {
			clearTimeout(timer);
			const bar = root!.querySelector<HTMLElement>('.c-stories i.is-active b');
			if (bar) { bar.style.animation = 'none'; void bar.offsetWidth; bar.style.animation = ''; }
			if (reduce || !inView || hovered) return;
			timer = window.setTimeout(() => go(current + 1, 1), DURATION);
		}

		function setPaused(p: boolean) {
			root!.classList.toggle('is-paused', p);
			if (p) clearTimeout(timer);
			else restart();
		}

		root.querySelector('[data-prev]')?.addEventListener('click', () => go(current - 1, -1));
		root.querySelector('[data-next]')?.addEventListener('click', () => go(current + 1, 1));
		[...cards, ...dots].forEach((el) => el.addEventListener('click', () => {
			const t = Number(el.dataset.go);
			go(t, wrap(t - current) >= 0 ? 1 : -1);
		}));

		const stage = root.querySelector<HTMLElement>('.c-stage')!;
		stage.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') { hovered = true; setPaused(true); } });
		stage.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') { hovered = false; setPaused(false); } });

		root.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowRight') { e.preventDefault(); go(current + 1, 1); }
			if (e.key === 'ArrowLeft') { e.preventDefault(); go(current - 1, -1); }
		});

		// swipe no celular
		const screen = root.querySelector<HTMLElement>('[data-swipe]')!;
		let sx = 0, sy = 0, tracking = false;
		screen.addEventListener('pointerdown', (e) => { sx = e.clientX; sy = e.clientY; tracking = true; });
		screen.addEventListener('pointerup', (e) => {
			if (!tracking) return;
			tracking = false;
			const dx = e.clientX - sx, dy = e.clientY - sy;
			if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) go(current + (dx < 0 ? 1 : -1), dx < 0 ? 1 : -1);
		});

		// reveal + autoplay só quando visível
		const io = new IntersectionObserver((entries) => {
			entries.forEach((en) => {
				if (en.target === root) {
					inView = en.isIntersecting;
					root.classList.toggle('is-playing', inView);
					if (inView) restart(); else clearTimeout(timer);
				} else if (en.isIntersecting) {
					en.target.classList.add('is-in');
				}
			});
		}, { threshold: 0.25 });
		io.observe(root);
		root.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

		// a 3ª dobra (Spotlight) pode pedir um talento específico
		window.addEventListener('adr:goto', (e) => {
			const t = Number((e as CustomEvent).detail?.index);
			if (Number.isFinite(t)) go(t, wrap(t - current) >= 0 ? 1 : -1);
		});

		layoutRing();
		root.classList.add('is-ready');
		window.dispatchEvent(new CustomEvent('adr:talent', { detail: { index: current } }));
	}
</script>

<style>
	@keyframes c-drift { 0% { transform: translate3d(0, 0, 0) scale(1); } 50% { transform: translate3d(6%, -5%, 0) scale(1.12); } 100% { transform: translate3d(-5%, 5%, 0) scale(.94); } }
	@keyframes c-fall { from { transform: translateY(-200px); } to { transform: translateY(120vh); } }
	@keyframes c-pan { to { background-position: 200% 50%; } }
	@keyframes c-marquee { to { transform: translateX(-50%); } }
	@keyframes c-pulse { 0% { box-shadow: 0 0 0 0 #5ae6cbb3; } 70% { box-shadow: 0 0 0 8px #5ae6cb00; } to { box-shadow: 0 0 #5ae6cb00; } }
	@keyframes c-glow { 0%, to { box-shadow: 0 0 0 0 #5ae6cb66, 0 10px 26px #5ae6cb40; } 50% { box-shadow: 0 0 0 8px #5ae6cb00, 0 10px 30px #5ae6cb80; } }
	@keyframes c-float { 0%, to { translate: 0 0; } 50% { translate: 0 -10px; } }
	@keyframes c-story { from { transform: scaleX(0); } to { transform: scaleX(1); } }
	@keyframes c-in { 0% { opacity: 0; transform: translateY(18px); filter: blur(8px); } 100% { opacity: 1; transform: none; filter: blur(0); } }
	@keyframes c-slide-up { 0% { transform: translateY(110%); } 100% { transform: translateY(0); } }
	@keyframes c-photo-in {
		0% { clip-path: inset(0 0 0 100%); transform: scale(1.18); filter: saturate(.4) brightness(.8); }
		100% { clip-path: inset(0 0 0 0); transform: scale(1); filter: none; }
	}
	@keyframes c-photo-in-back {
		0% { clip-path: inset(0 100% 0 0); transform: scale(1.18); filter: saturate(.4) brightness(.8); }
		100% { clip-path: inset(0 0 0 0); transform: scale(1); filter: none; }
	}
	@keyframes c-photo-out { 0% { transform: scale(1); opacity: 1; } 100% { transform: scale(.92) translateX(calc(var(--dir, 1) * -8%)); opacity: .2; } }
	@keyframes c-bar { from { transform: scaleX(0); } to { transform: scaleX(1); } }
	@keyframes c-ken { 0% { transform: scale(1); } 100% { transform: scale(1.08); } }
	@keyframes c-spin { to { --c-angle: 360deg; } }

	@property --c-angle { syntax: "<angle>"; initial-value: 0deg; inherits: false; }

	.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

	/* =========================================================
	   SEÇÃO
	   ========================================================= */
	.casting {
		--card-w: clamp(150px, 13vw, 208px);
		--phone-w: clamp(250px, min(20vw, 31vh), 312px);
		--gap: calc(var(--phone-w) * .98);
		position: relative;
		isolation: isolate;
		overflow: hidden;
		min-height: 100svh;
		padding: clamp(44px, 6.5vh, 88px) 0 clamp(36px, 5vh, 56px);
		color: #fff;
		background: #07031f;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.c-bg { position: absolute; inset: 0; z-index: -1; pointer-events: none; overflow: hidden; }
	.c-bg::before {
		content: "";
		position: absolute;
		inset: 0;
		background:
			radial-gradient(circle at 78% 12%, #3158ff73 0, #0000 34%),
			radial-gradient(circle at 10% 92%, #5ae6cb24 0, #0000 32%),
			linear-gradient(180deg, #07031f 0%, #100057 55%, #0b0640 100%);
	}
	.c-grid {
		position: absolute;
		inset: 0;
		background-size: 48px 48px;
		background-image:
			linear-gradient(to right, #ffffff0d 1px, transparent 1px),
			linear-gradient(to bottom, #ffffff0d 1px, transparent 1px);
		-webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 45%, #000 20%, transparent 75%);
		mask-image: radial-gradient(ellipse 70% 60% at 50% 45%, #000 20%, transparent 75%);
	}
	.c-glow { position: absolute; left: 50%; top: 58%; width: 70vmin; height: 70vmin; translate: -50% -50%; border-radius: 50%; background: radial-gradient(circle, #0d4bf7aa 0, #3843d040 35%, transparent 68%); filter: blur(30px); }
	.aurora-x { position: absolute; border-radius: 50%; filter: blur(90px); animation: c-drift 22s ease-in-out infinite alternate; opacity: .35; }
	.aurora-blue { background: radial-gradient(circle, #3158ff 0, transparent 65%); }
	.aurora-mint { background: radial-gradient(circle, #5ae6cb 0, transparent 65%); }
	.aurora-violet { background: radial-gradient(circle, #8f60ff 0, transparent 65%); }
	.x1 { width: 40rem; height: 40rem; top: -14rem; left: -12rem; }
	.x2 { width: 34rem; height: 34rem; bottom: -12rem; right: -8rem; opacity: .22; animation-delay: -8s; }
	.x3 { width: 28rem; height: 28rem; top: 30%; right: 18%; opacity: .2; animation-delay: -14s; }
	.c-beam { position: absolute; top: 0; width: 1px; height: 200px; background: linear-gradient(to bottom, transparent, #0d4bf7b3, #5ae6cbe6); animation: c-fall 10s linear infinite; opacity: .45; }
	.c-beam::after { content: ""; position: absolute; bottom: -2px; left: -2px; width: 5px; height: 5px; border-radius: 50%; background: #5ae6cb; box-shadow: 0 0 12px 3px #5ae6cbcc; }

	/* reveal ao rolar */
	[data-reveal] { opacity: 0; transform: translateY(40px); filter: blur(8px); transition: opacity 1.1s var(--ease-expo), transform 1.1s var(--ease-expo), filter 1.1s var(--ease-expo); }
	[data-reveal].is-in { opacity: 1; transform: none; filter: blur(0); }
