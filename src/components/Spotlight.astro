	.se-frame { position: absolute; left: 50%; top: 50%; translate: -50% -50%; z-index: 2; width: 280px; height: 594px; border-radius: 40px; overflow: hidden; background: #0b0b10; will-change: width, height; }
	.se-media { position: absolute; inset: 0; opacity: 0; transition: opacity .6s; }
