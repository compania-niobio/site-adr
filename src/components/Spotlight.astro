---
/**
 * Terceira dobra — Spotlight do talento
 * Começa na 2ª dobra: o celular "abre" (ScrollExpand do design_system.html) e vira
 * a página do talento selecionado no carrossel. Sincroniza via eventos:
 *   - ouve  `adr:talent` {index}  (emitido pelo Casting)
 *   - emite `adr:goto`   {index}  (pede ao Casting para trocar de talento)
 */
import { Image } from 'astro:assets';
import logo from '../assets/hero/adr-logo.png';
import { talents, socialIcons as icons } from '../data/talents';

const logoVar = `--logo:url("${logo.src}")`;
const pad = (n: number) => String(n).padStart(2, '0');
const first = (name: string) => name.split(' ')[0];
const proposalUrl = 'https://adragencia.com.br/fale-com-a-adr';

// variações de recorte/tom para a lista de pontos fortes (mesma foto, leituras diferentes)
const looks = [
	{ pos: '50% 22%', tint: 'tint-blue', scale: 1.05 },
	{ pos: '35% 45%', tint: 'tint-mint', scale: 1.35 },
	{ pos: '62% 30%', tint: 'tint-violet', scale: 1.6 },
	{ pos: '50% 70%', tint: 'tint-pink', scale: 1.25 },
	{ pos: '45% 15%', tint: 'tint-blue', scale: 1.9 },
];

const ui = {
	heart: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M12 20s-7.5-4.6-9.2-9.3C1.6 7.2 3.9 4 7.3 4c2 0 3.6 1.1 4.7 2.7C13.1 5.1 14.7 4 16.7 4c3.4 0 5.7 3.2 4.5 6.7C19.5 15.4 12 20 12 20Z"/></svg>',
	comment: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12Z"/></svg>',
	send: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M22 3 9.5 13.5M22 3l-7 18-5.5-7.5L2 10l20-7Z"/></svg>',
	save: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M6 3h12v18l-6-4.5L6 21V3Z"/></svg>',
	share: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M14 4v4C6 9 3 14 3 20c2.5-3.5 6-5 11-5v4l7-7.5L14 4Z"/></svg>',
	play: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.6-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5Z"/></svg>',
	arrow: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"/></svg>',
	pin: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.4"/></svg>',
};

const pages = talents.map((t, i) => {
	const sorted = [...t.metrics].sort((a, b) => b.n - a.n);
	const max = sorted[0].n;
	return {
		...t,
		i,
		next: talents[(i + 1) % talents.length],
		top: sorted[0],
		orbit: sorted.map((m, k) => ({
			...m,
			size: Math.round(50 + 36 * Math.sqrt(m.n / max)),
			ring: k,
			angle: Math.round(k * (360 / sorted.length) * 1.37 + 28) % 360,
		})),
		words: t.story.aboutTitle.split(' '),
		chars: t.name.split(''),
	};
});
---

<section class="spot" id="talento" data-spot style={logoVar} aria-label="Página do talento">
	<!-- =====================================================
	     A) SCROLL EXPAND — o celular abre e vira a página
	     ===================================================== -->
	<div class="se" data-se>
		<div class="se-track" data-se-track>
			<div class="se-stage" data-se-stage>
				<div class="se-grid" aria-hidden="true"></div>
				<div class="se-ghost" aria-hidden="true">
					{pages.map((p) => <span class:list={['se-ghost-name', { 'is-active': p.i === 0 }]} data-ti={p.i}>{p.name}</span>)}
				</div>

				<!-- palavras que o quadro empurra para fora -->
				<div class="se-side se-side-l" data-se-left aria-hidden="true"><span>Role para</span></div>
				<div class="se-side se-side-r" data-se-right aria-hidden="true">
					<span>conhecer</span>
					{pages.map((p) => <b class:list={['se-side-name', { 'is-active': p.i === 0 }]} data-ti={p.i}>{first(p.name)}</b>)}
				</div>

				<!-- moldura do celular (some durante a expansão) -->
				<div class="se-bezel" data-se-bezel aria-hidden="true"><span class="se-island"></span></div>

				<div class="se-frame" data-se-frame>
					{pages.map((p) => (
						<div class:list={['se-media', { 'is-active': p.i === 0 }]} data-ti={p.i}>
							<Image src={p.img} alt="" width={1600} densities={[1]} loading={p.i < 2 ? 'eager' : 'lazy'} style={`object-position:${p.pos}`} data-se-img />
						</div>
					))}
					<div class="se-scrim" data-se-scrim></div>

					<!-- hero do talento -->
					<div class="se-overlay" data-se-overlay>
						{pages.map((p) => (
							<div class:list={['se-hero', { 'is-active': p.i === 0 }]} data-ti={p.i}>
								<div class="se-hero-top">
									<span class="sp-eyebrow light"><span class="sp-live"></span>Influenciador ADR</span>
									<span class="se-loc"><span set:html={ui.pin} />{p.location}</span>
								</div>
								<h2 class="se-name" aria-label={p.name}>
									{p.chars.map((c, k) => <span style={`--k:${k}`} aria-hidden="true">{c === ' ' ? ' ' : c}</span>)}
								</h2>
								<div class="se-hero-bottom">
									<p class="se-tag">{p.tagline}</p>
									<div class="se-total">
										<strong>{p.totalLabel}</strong>
										<span>de seguidores somados em {p.metrics.length} redes</span>
									</div>
								</div>
								<ul class="se-niches">{p.niches.map((n, k) => <li style={`--k:${k}`}>{n}</li>)}</ul>
							</div>
						))}

						<a class="se-badge" href="#talento-pagina" aria-label="Ir para a página do talento">
							<svg viewBox="0 0 120 120" aria-hidden="true">
								<defs><path id="se-circle" d="M60 60 m-46 0 a46 46 0 1 1 92 0 a46 46 0 1 1 -92 0" /></defs>
								<text><textPath href="#se-circle">CASTING EXCLUSIVO ADR • CASTING EXCLUSIVO ADR • </textPath></text>
							</svg>
							<span class="se-badge-ico" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M6 13l6 6 6-6" /></svg></span>
						</a>
					</div>
				</div>

				<div class="se-hint" data-se-hint aria-hidden="true">Role para abrir<span class="se-cue"></span></div>
			</div>
		</div>
	</div>

	<!-- =====================================================
	     B) PÁGINA DO TALENTO (uma por talento, só a ativa aparece)
	     ===================================================== -->
	<div class="tp-wrap" id="talento-pagina">
		{pages.map((p) => (
			<article class:list={['tp', { 'is-active': p.i === 0 }]} data-tp data-ti={p.i} aria-label={`Página de ${p.name}`} aria-hidden={p.i === 0 ? 'false' : 'true'}>

				{/* ---------- B1 · PONTOS FORTES ---------- */}
				<section class="tp-sec tp-strengths">
					<div class="tp-strengths-side">
						<div class="tp-head" data-sr>
							<span class="sp-index">01 / Pontos fortes</span>
							<h3 class="tp-h">O que move <em>{first(p.name)}</em></h3>
						</div>
						<div class="tp-bento">
							<div class="bento b-navy" data-sr style="--sd:.05s">
								<span class="bento-k">Rede principal</span>
								<span class="bento-ico" set:html={icons[p.top.network]} />
								<strong>{p.top.value}</strong>
								<span class="bento-sub">no {p.top.network}</span>
							</div>
							<div class="bento b-soft" data-sr style="--sd:.12s">
								<span class="bento-k">Presença</span>
								<strong><span data-count-to={p.metrics.length}>{p.metrics.length}</span></strong>
								<span class="bento-sub">redes sociais ativas</span>
								<div class="bento-icons">{p.metrics.map((m) => <span set:html={icons[m.network]} />)}</div>
							</div>
							<div class="bento b-mint" data-sr style="--sd:.19s">
								<span class="bento-k">Base</span>
								<span class="bento-ico" set:html={ui.pin} />
								<strong class="bento-loc">{p.location}</strong>
							</div>
						</div>
					</div>

					<div class="tp-reveal-list" data-hover-list>
						<ul>
							{p.niches.map((n, k) => (
								<li data-sr style={`--sd:${k * 0.07}s`} data-look={k % looks.length}>
									<span class="rl-num">{pad(k + 1)}</span>
									<span class="rl-name">{n}</span>
									<span class="rl-arrow" set:html={ui.arrow} />
								</li>
							))}
						</ul>
						<div class="rl-float" aria-hidden="true" data-hover-float>
							{looks.map((l, k) => (
								<div class:list={['rl-img', l.tint]} data-look={k} style={`--s:${l.scale}`}>
									<Image src={p.img} alt="" width={480} loading="lazy" style={`object-position:${l.pos}`} />
								</div>
							))}
						</div>
					</div>
				</section>

				{/* ---------- B2 · ALCANCE (órbita) ---------- */}
				<section class="tp-sec tp-reach">
					<div class="tp-reach-bg" aria-hidden="true"><div class="reach-aurora"></div><div class="reach-grid"></div></div>
					<div class="orbit-wrap" data-sr>
						<div class="orbit-sys">
							{p.orbit.map((m) => (
								<div class="o-ring" style={`--r:${m.ring};--dur:${36 + m.ring * 14}s;--a:${m.angle}deg;--sz:${m.size}px`}>
									<div class="o-arm">
										<div class="o-node">
											<a class="o-planet" href={m.url} target="_blank" rel="noopener" tabindex="-1" aria-label={`${p.name} no ${m.network}: ${m.value}`}>
												<span class="o-ico" set:html={icons[m.network]} />
												<b>{m.value}</b>
											</a>
										</div>
									</div>
								</div>
							))}
							<div class="o-core">
								<Image src={p.img} alt="" width={260} loading="lazy" style={`object-position:${p.pos}`} />
							</div>
						</div>
					</div>

					<div class="reach-copy">
						<div class="tp-head light" data-sr>
							<span class="sp-index">02 / Alcance digital</span>
							<h3 class="tp-h">Uma audiência que <em>atravessa plataformas.</em></h3>
						</div>
						<div class="reach-total" data-sr style="--sd:.1s">
							<strong data-count-total={p.total}>{p.totalLabel}</strong>
							<span>de seguidores somados<br />em {p.metrics.length} redes</span>
						</div>
						<ul class="reach-list">
							{p.metrics.map((m, k) => (
								<li data-sr style={`--sd:${0.15 + k * 0.07}s;--w:${p.bars[k]}%`}>
									<span class="rli" set:html={icons[m.network]} />
									<span class="rln">{m.network}</span>
									<span class="rlb"><i></i></span>
									<b>{m.value}</b>
								</li>
							))}
						</ul>
					</div>
				</section>

				{/* ---------- B3 · HISTÓRIA ---------- */}
				<section class="tp-sec tp-story">
					<figure class="story-photo" data-sr>
						<div class="story-photo-in" data-parallax>
							<Image src={p.img} alt={`${p.name}`} width={900} loading="lazy" style={`object-position:${p.pos}`} />
						</div>
						<span class="story-duotone" aria-hidden="true"></span>
						<figcaption><span class="sp-live"></span>{p.name} · {p.location}</figcaption>
					</figure>

					<div class="story-copy">
						<span class="sp-index dark" data-sr>03 / História</span>
						<h3 class="story-title" data-scrub>
							{p.words.map((w) => <span class="sw">{w} </span>)}
						</h3>
						<p class="story-lead" data-sr>{p.story.bio}</p>
						<div class="story-cols">
							{p.story.about.map((para, k) => <p data-sr style={`--sd:${k * 0.06}s`}>{para}</p>)}
						</div>
					</div>
				</section>

				{/* ---------- B4 · CONTEÚDO NAS REDES ---------- */}
				<section class="tp-sec tp-content">
					<div class="content-head">
						<div class="tp-head light" data-sr>
							<span class="sp-index">04 / Conteúdo</span>
							<h3 class="tp-h">Onde {first(p.name)} <em>acontece.</em></h3>
						</div>
						<p class="content-note" data-sr style="--sd:.1s">Arraste para o lado e abra os perfis oficiais.</p>
					</div>

					<div class="rail" data-rail>
						{p.metrics.map((m, k) => (
							<a class:list={['post', `post-${m.network.toLowerCase().replace(/\s/g, '')}`]} href={m.url} target="_blank" rel="noopener" data-sr style={`--sd:${k * 0.08}s`} aria-label={`Abrir ${m.network} de ${p.name}`}>
								{m.network === 'Instagram' && (
									<>
										<header class="post-top">
											<span class="post-avatar"><Image src={p.img} alt="" width={80} loading="lazy" style={`object-position:${p.pos}`} /></span>
											<span class="post-handle">{p.handle}<small>{p.location}</small></span>
											<span class="post-dots">•••</span>
										</header>
										<div class="post-media sq"><Image src={p.img} alt="" width={640} loading="lazy" style={`object-position:${p.pos}`} /><span class="post-heart" set:html={ui.heart} /></div>
										<div class="post-actions"><span set:html={ui.heart} /><span set:html={ui.comment} /><span set:html={ui.send} /><span class="push" set:html={ui.save} /></div>
										<footer class="post-foot"><b>{m.value}</b> seguidores<span class="post-open">Ver no Instagram <i set:html={ui.arrow} /></span></footer>
									</>
								)}
								{m.network.startsWith('TikTok') && (
									<>
										<div class="post-media tall">
											<Image src={p.img} alt="" width={560} loading="lazy" style={`object-position:${p.pos}`} />
											<span class="tk-play" set:html={ui.play} />
											<div class="tk-side"><span class="tk-av"><Image src={p.img} alt="" width={80} loading="lazy" style={`object-position:${p.pos}`} /></span><span set:html={ui.heart} /><span set:html={ui.comment} /><span set:html={ui.share} /></div>
											<div class="tk-info"><b>{p.handle}</b><span>{m.network} · {m.value} seguidores</span></div>
											<span class="tk-progress"><i></i></span>
										</div>
										<footer class="post-foot dark"><span class="post-net" set:html={icons.TikTok} />{m.network}<span class="post-open">Abrir <i set:html={ui.arrow} /></span></footer>
									</>
								)}
								{m.network === 'YouTube' && (
									<>
										<div class="post-media wide">
											<Image src={p.img} alt="" width={800} loading="lazy" style={`object-position:${p.pos}`} />
											<span class="yt-play" set:html={ui.play} />
											<span class="yt-bar"><i></i></span>
										</div>
										<footer class="yt-foot">
											<span class="post-avatar"><Image src={p.img} alt="" width={80} loading="lazy" style={`object-position:${p.pos}`} /></span>
											<span class="yt-meta"><b>{p.name}</b><span>{m.value} de inscritos</span></span>
											<span class="post-open">Abrir canal <i set:html={ui.arrow} /></span>
										</footer>
									</>
								)}
								{!['Instagram', 'YouTube'].includes(m.network) && !m.network.startsWith('TikTok') && (
									<div class="txt-card">
										<span class="txt-ico" set:html={icons[m.network]} />
										<span class="txt-handle">{p.handle}</span>
										<strong>{m.value}</strong>
										<span class="txt-sub">seguidores no {m.network}</span>
										<span class="post-open">Abrir perfil <i set:html={ui.arrow} /></span>
									</div>
								)}
							</a>
						))}
					</div>
				</section>

				{/* ---------- B5 · MARCAS ---------- */}
				{p.story.brands.length > 0 && (
					<section class="tp-sec tp-brands" aria-label="Marcas e parcerias">
						<div class="tp-head center" data-sr>
							<span class="sp-index dark">05 / Marcas e parcerias</span>
							<h3 class="tp-h dark">Projetos que fizeram parte <em>da trajetória.</em></h3>
						</div>
						<div class="brand-rows" aria-hidden="true">
							{[0, 1].map((row) => (
								<div class:list={['brand-row', { rev: row === 1 }]}>
									<div class="brand-track">
										{[0, 1].map(() => (
											<div class="brand-set">
												{(row === 0 ? p.story.brands : [...p.story.brands].reverse()).map((b, k) => (
													<><span class:list={{ outline: (k + row) % 2 === 1 }}>{b}</span><i>✦</i></>
												))}
											</div>
										))}
									</div>
								</div>
							))}
						</div>
						<ul class="sr-only">{p.story.brands.map((b) => <li>{b}</li>)}</ul>
					</section>
				)}

				{/* ---------- B6 · PROJETOS / CTA ---------- */}
				<section class="tp-sec tp-cta">
					<div class="cta-bg" aria-hidden="true">
						<span class="cta-ghost">{p.name}</span>
						<div class="cta-aurora a"></div><div class="cta-aurora b"></div>
					</div>
					<div class="cta-copy">
						<span class="sp-index" data-sr>{p.story.brands.length ? '06' : '05'} / Projetos e parcerias</span>
						<h3 class="cta-title" data-sr style="--sd:.05s">{p.story.projectsTitle}</h3>
						<p class="cta-text" data-sr style="--sd:.12s">{p.story.projects}</p>
						<div class="cta-actions" data-sr style="--sd:.18s">
							<a class="sp-btn" href={proposalUrl} target="_blank" rel="noopener">
								<span class="sp-btn-ring"><span class="sp-btn-in">Solicitar proposta<span class="sp-btn-ico" set:html={ui.arrow} /></span></span>
							</a>
							<a class="sp-link" href="#casting">Voltar ao casting</a>
						</div>
					</div>

					<button class="next-card" type="button" data-next-talent={p.next ? (p.i + 1) % talents.length : 0} data-sr style="--sd:.2s">
						<span class="next-k">Próximo talento <i set:html={ui.arrow} /></span>
						<span class="next-img"><Image src={p.next.img} alt="" width={480} loading="lazy" style={`object-position:${p.next.pos}`} /></span>
						<span class="next-name">{p.next.name}</span>
						<span class="next-sub">{p.next.totalLabel} seguidores</span>
					</button>
				</section>
			</article>
		))}
	</div>

	<!-- dock flutuante enquanto lê a página do talento -->
	<div class="tp-dock" data-dock aria-hidden="true">
		<span class="dock-av">
			{pages.map((p) => <span class:list={['dock-av-img', { 'is-active': p.i === 0 }]} data-ti={p.i}><Image src={p.img} alt="" width={80} style={`object-position:${p.pos}`} /></span>)}
		</span>
		<span class="dock-name">
			{pages.map((p) => <span class:list={{ 'is-active': p.i === 0 }} data-ti={p.i}>{p.name}</span>)}
		</span>
		<span class="dock-prog"><i data-dock-prog></i></span>
		<button type="button" class="dock-btn" data-dock-next tabindex="-1">Próximo <span set:html={ui.arrow} /></button>
	</div>
</section>

<script>
	const spot = document.querySelector<HTMLElement>('[data-spot]');
	if (spot) {
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const clamp = (v: number, a: number, b: number) => (v < a ? a : v > b ? b : v);
		const smooth = (e0: number, e1: number, x: number) => { const t = clamp((x - e0) / (e1 - e0 || 1e-6), 0, 1); return t * t * (3 - 2 * t); };
		const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
		const count = spot.querySelectorAll('[data-tp]').length;
		let active = 0;

		/* ---------------- sincronização com o Casting ---------------- */
		function setActive(i: number) {
			if (i === active || i < 0 || i >= count) return;
			active = i;
			spot!.querySelectorAll<HTMLElement>('[data-ti]').forEach((el) => {
				const on = Number(el.dataset.ti) === i;
				el.classList.toggle('is-active', on);
				if (el.matches('[data-tp]')) {
					el.setAttribute('aria-hidden', on ? 'false' : 'true');
					if (on) el.querySelectorAll('.is-in').forEach((x) => x.classList.remove('is-in'));
				}
			});
			spot!.querySelectorAll<HTMLElement>('.se-name span').forEach((s) => { s.style.animation = 'none'; void s.offsetWidth; s.style.animation = ''; });
			measureScrub();
		}
		window.addEventListener('adr:talent', (e) => setActive(Number((e as CustomEvent).detail?.index ?? 0)));

		const goto = (i: number) => {
			window.dispatchEvent(new CustomEvent('adr:goto', { detail: { index: i } }));
			setActive(i); // fallback caso o Casting não esteja na página
			const top = spot!.getBoundingClientRect().top + window.scrollY;
			window.scrollTo({ top, behavior: reduce ? 'auto' : 'smooth' });
		};
		spot.querySelectorAll<HTMLElement>('[data-next-talent]').forEach((b) => b.addEventListener('click', () => goto(Number(b.dataset.nextTalent))));
		spot.querySelector('[data-dock-next]')?.addEventListener('click', () => goto((active + 1) % count));

		/* ---------------- ScrollExpand (port do design_system.html) ---------------- */
		const track = spot.querySelector<HTMLElement>('[data-se-track]')!;
		const stage = spot.querySelector<HTMLElement>('[data-se-stage]')!;
		const frame = spot.querySelector<HTMLElement>('[data-se-frame]')!;
		const bezel = spot.querySelector<HTMLElement>('[data-se-bezel]')!;
		const scrim = spot.querySelector<HTMLElement>('[data-se-scrim]')!;
		const overlay = spot.querySelector<HTMLElement>('[data-se-overlay]')!;
		const hint = spot.querySelector<HTMLElement>('[data-se-hint]')!;
		const left = spot.querySelector<HTMLElement>('[data-se-left]')!;
		const right = spot.querySelector<HTMLElement>('[data-se-right]')!;
		const cfg = { distance: 1.35, hold: 0.3, zoom: 1.12, smoothing: 0.1, scrim: 0.55 };
		let W = 0, H = 0, startW = 0, startH = 0, startR = 44;
		let seCur = 0, seTarget = 0, seRaf = 0;

		function measureSE() {
			W = stage.clientWidth || window.innerWidth;
			H = window.innerHeight;
			stage.style.height = `${H}px`;
			track.style.height = `${H * (1 + cfg.distance + cfg.hold)}px`;
			// mesmo tamanho da tela do celular da 2ª dobra
			startW = clamp(Math.min(W * 0.72, H * 0.33), 230, 300);
			startH = startW * 2.12;
			if (startH > H * 0.82) { startH = H * 0.82; startW = startH / 2.12; }
			startR = startW * 0.14;
		}

		function applySE(p: number) {
			const e = smooth(0, 1, p);
			const w = lerp(startW, W, e), h = lerp(startH, H, e), r = lerp(startR, 0, e);
			frame.style.width = `${w}px`;
			frame.style.height = `${h}px`;
			frame.style.borderRadius = `${r}px`;
			spot!.style.setProperty('--se-zoom', String(lerp(cfg.zoom, 1, e)));
			scrim.style.opacity = String(cfg.scrim * smooth(0.2, 1, p));

			const bz = smooth(0, 0.3, p);
			bezel.style.width = `${w + 22}px`;
			bezel.style.height = `${h + 22}px`;
			bezel.style.borderRadius = `${r + 11}px`;
			bezel.style.opacity = String(1 - bz);

			const side = smooth(0, 0.45, p);
			left.style.right = `${W / 2 + w / 2 + 40}px`;
			right.style.left = `${W / 2 + w / 2 + 40}px`;
			left.style.opacity = right.style.opacity = String(1 - side);

			hint.style.opacity = String(1 - smooth(0, 0.12, p));
			const inn = smooth(0.7, 1, p);
			overlay.style.opacity = String(inn);
			overlay.style.transform = `translate3d(0, ${24 * (1 - inn)}px, 0)`;
			overlay.style.pointerEvents = inn > 0.5 ? 'auto' : 'none';
			spot!.classList.toggle('se-open', inn > 0.6);
		}

		const readSE = () => clamp(-track.getBoundingClientRect().top / (H * cfg.distance), 0, 1);
		function tickSE() {
			const k = 1 - Math.exp(-1 / (60 * cfg.smoothing));
			seCur += (seTarget - seCur) * k;
			if (Math.abs(seTarget - seCur) < 0.0004) seCur = seTarget;
			applySE(seCur);
			seRaf = seCur !== seTarget ? requestAnimationFrame(tickSE) : 0;
		}

		/* ---------------- scrub do título da história ---------------- */
		let scrubWords: HTMLElement[] = [];
		let scrubEl: HTMLElement | null = null;
		function measureScrub() {
			scrubEl = spot!.querySelector<HTMLElement>('.tp.is-active [data-scrub]');
			scrubWords = scrubEl ? [...scrubEl.querySelectorAll<HTMLElement>('.sw')] : [];
		}
		function applyScrub() {
			if (!scrubEl) return;
			const r = scrubEl.getBoundingClientRect();
			const p = clamp((H * 0.85 - r.top) / (H * 0.5), 0, 1);
			const lit = p * scrubWords.length;
			scrubWords.forEach((w, k) => w.style.setProperty('--lit', String(clamp(lit - k, 0, 1))));
		}

		/* ---------------- parallax + dock ---------------- */
		const dock = spot.querySelector<HTMLElement>('[data-dock]')!;
		const dockProg = spot.querySelector<HTMLElement>('[data-dock-prog]')!;
		function applyPage() {
			const page = spot!.querySelector<HTMLElement>('.tp.is-active');
			if (!page) return;
			const r = page.getBoundingClientRect();
			const inside = r.top < H * 0.35 && r.bottom > H * 0.6;
			dock.classList.toggle('is-on', inside);
			dock.querySelector('button')!.tabIndex = inside ? 0 : -1;
			dockProg.style.transform = `scaleX(${clamp(-r.top / (r.height - H), 0, 1)})`;
			if (reduce) return;
			page.querySelectorAll<HTMLElement>('[data-parallax]').forEach((el) => {
				const b = el.parentElement!.getBoundingClientRect();
				const t = (b.top + b.height / 2 - H / 2) / H;
				el.style.transform = `translate3d(0, ${t * -60}px, 0) scale(1.15)`;
			});
		}

		/* ---------------- loop de scroll ---------------- */
		function onScroll() {
			seTarget = readSE();
			if (reduce) { seCur = seTarget; applySE(seCur); }
			else if (!seRaf) seRaf = requestAnimationFrame(tickSE);
			applyScrub();
			applyPage();
		}
		function onResize() { measureSE(); measureScrub(); seTarget = seCur = readSE(); applySE(seCur); applyScrub(); applyPage(); }
		window.addEventListener('scroll', onScroll, { passive: true });
		window.addEventListener('resize', onResize);
		onResize();

		/* ---------------- reveals + contadores ---------------- */
		const fmt = (n: number) => (n >= 1e6 ? `${(n / 1e6).toFixed(1).replace('.', ',')} mi` : `${Math.round(n / 1e3)} mil`);
		const fmtEnd = (n: number) => (n >= 1e6 ? `${(n / 1e6).toFixed(1).replace('.', ',').replace(',0', '')} mi` : `${Math.round(n / 1e3)} mil`);
		function countUp(el: HTMLElement) {
			const total = Number(el.dataset.countTotal || el.dataset.countTo);
			const isTotal = !!el.dataset.countTotal;
			if (reduce || !total) return;
			const t0 = performance.now(), dur = 1400;
			const step = (now: number) => {
				const q = Math.min(1, (now - t0) / dur), v = total * (1 - Math.pow(1 - q, 4));
				el.textContent = isTotal ? (q < 1 ? fmt(v) : fmtEnd(total)) : String(Math.round(v));
				if (q < 1) requestAnimationFrame(step);
			};
			requestAnimationFrame(step);
		}
		const io = new IntersectionObserver((entries) => {
			entries.forEach((en) => {
				if (!en.isIntersecting) return;
				const el = en.target as HTMLElement;
				el.classList.add('is-in');
				el.querySelectorAll<HTMLElement>('[data-count-total],[data-count-to]').forEach(countUp);
			});
		}, { threshold: 0.18, rootMargin: '0px 0px -6% 0px' });
		spot.querySelectorAll('[data-sr]').forEach((el) => io.observe(el));

		/* ---------------- lista com foto que segue o cursor ---------------- */
		const fine = window.matchMedia('(pointer: fine)').matches;
		spot.querySelectorAll<HTMLElement>('[data-hover-list]').forEach((list) => {
			const float = list.querySelector<HTMLElement>('[data-hover-float]')!;
			const imgs = [...float.querySelectorAll<HTMLElement>('.rl-img')];
			let x = 0, y = 0, cx = 0, cy = 0, raf = 0, vx = 0;
			const loop = () => {
				const nx = lerp(cx, x, 0.14), ny = lerp(cy, y, 0.14);
				vx = nx - cx; cx = nx; cy = ny;
				float.style.transform = `translate3d(${cx}px, ${cy}px, 0) translate(-50%, -50%) rotate(${clamp(vx * 0.8, -12, 12)}deg)`;
				raf = Math.abs(x - cx) + Math.abs(y - cy) > 0.3 ? requestAnimationFrame(loop) : 0;
			};
			list.querySelectorAll<HTMLElement>('li').forEach((li) => {
				li.addEventListener('pointerenter', () => {
					const look = li.dataset.look;
					imgs.forEach((im) => im.classList.toggle('is-on', im.dataset.look === look));
				});
			});
			if (!fine) return;
			list.addEventListener('pointermove', (e) => {
				const r = list.getBoundingClientRect();
				x = e.clientX - r.left; y = e.clientY - r.top;
				if (!float.classList.contains('is-show')) { cx = x; cy = y; }
				float.classList.add('is-show');
				if (!raf) raf = requestAnimationFrame(loop);
			});
			list.addEventListener('pointerleave', () => float.classList.remove('is-show'));
		});

		/* ---------------- rail arrastável ---------------- */
		spot.querySelectorAll<HTMLElement>('[data-rail]').forEach((rail) => {
			let down = false, sx = 0, sl = 0, moved = false;
			rail.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse') return; down = true; moved = false; sx = e.clientX; sl = rail.scrollLeft; rail.classList.add('is-drag'); });
			window.addEventListener('pointerup', () => { down = false; rail.classList.remove('is-drag'); });
			rail.addEventListener('pointermove', (e) => { if (!down) return; const dx = e.clientX - sx; if (Math.abs(dx) > 4) moved = true; rail.scrollLeft = sl - dx; });
			rail.addEventListener('click', (e) => { if (moved) { e.preventDefault(); moved = false; } }, true);
		});
	}
</script>

<style>
	@keyframes sp-pulse { 0% { box-shadow: 0 0 0 0 #5ae6cbb3; } 70% { box-shadow: 0 0 0 8px #5ae6cb00; } to { box-shadow: 0 0 #5ae6cb00; } }
	@keyframes sp-char { 0% { transform: translateY(105%) rotate(8deg); opacity: 0; } 100% { transform: none; opacity: 1; } }
	@keyframes sp-in { 0% { opacity: 0; transform: translateY(14px); filter: blur(6px); } 100% { opacity: 1; transform: none; filter: blur(0); } }
	@keyframes sp-spin { to { transform: rotate(360deg); } }
	@keyframes sp-counter { to { transform: rotate(-360deg); } }
	@keyframes sp-marquee { to { transform: translateX(-50%); } }
	@keyframes sp-marquee-rev { from { transform: translateX(-50%); } to { transform: translateX(0); } }
	@keyframes sp-cue { 0% { transform: translateY(-100%); } 100% { transform: translateY(200%); } }
	@keyframes sp-pan { to { background-position: 200% 50%; } }
	@keyframes sp-drift { 0% { transform: translate3d(0, 0, 0) scale(1); } 50% { transform: translate3d(6%, -6%, 0) scale(1.12); } 100% { transform: translate3d(-5%, 5%, 0) scale(.94); } }
	@keyframes sp-ken { 0% { transform: scale(1.02) translate(0, 0); } 100% { transform: scale(1.16) translate(-2%, -3%); } }
	@keyframes sp-progress { from { transform: scaleX(0); } to { transform: scaleX(1); } }
	@keyframes sp-beat { 0%, 100% { transform: translate(-50%, -50%) scale(1); } 50% { transform: translate(-50%, -50%) scale(1.1); } }
	@keyframes sp-ring { to { --sp-angle: 360deg; } }
	@property --sp-angle { syntax: "<angle>"; initial-value: 0deg; inherits: false; }

	.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

	.spot { position: relative; background: #0b0640; color: #fff; }

	/* utilitários compartilhados */
	.sp-eyebrow { display: inline-flex; align-items: center; gap: 9px; font-family: var(--font-mono); font-size: 10.5px; font-weight: 500; letter-spacing: .16em; text-transform: uppercase; padding: 7px 13px; border-radius: 999px; color: #fff; background: #ffffff1a; border: 1px solid #ffffff33; backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
