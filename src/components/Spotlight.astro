	.se-side-name { grid-area: 2 / 1; font-weight: 850; font-style: italic; text-transform: uppercase; letter-spacing: -.06em; background: linear-gradient(110deg, #fff 0%, var(--periwinkle) 30%, var(--mint) 50%, var(--periwinkle) 70%, #fff 100%); background-size: 200% auto; -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; animation: sp-pan 9s linear infinite; opacity: 0; transform: translateY(20px); transition: opacity .6s, transform .6s var(--ease-expo); }
	.se-side-name.is-active { opacity: 1; transform: none; }

	.se-bezel {
		position: absolute;
