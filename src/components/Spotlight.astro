	.bento-ico { position: absolute; right: 18px; top: 18px; width: 26px; height: 26px; }
	.bento-ico :global(svg) { width: 100%; height: 100%; }
	.b-navy { grid-row: span 2; background: radial-gradient(circle at 80% 0%, #3158ff 0, transparent 60%), var(--navy); color: #fff; }
	.b-navy strong { font-size: clamp(34px, 3vw, 50px); color: var(--mint); white-space: nowrap; }
	.b-soft { background: var(--soft); border: 1px solid var(--line); color: var(--navy); }
	.bento-icons { display: flex; gap: 8px; margin-top: 8px; }
	.bento-icons span { display: grid; width: 18px; height: 18px; color: var(--blue); }
	.bento-icons :global(svg) { width: 100%; height: 100%; }
	.b-mint { background: var(--mint); color: var(--navy); }
	.bento-loc { font-size: 22px !important; letter-spacing: -.03em !important; }

	.tp-reveal-list { position: relative; }
	.tp-reveal-list ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
	.tp-reveal-list li { position: relative; display: grid; grid-template-columns: 56px 1fr auto; align-items: center; gap: 16px; padding: clamp(18px, 2.6vw, 30px) 0; border-bottom: 1px solid var(--line); cursor: default; }
	.tp-reveal-list li::after { content: ""; position: absolute; left: 0; bottom: -1px; height: 2px; width: 100%; background: var(--ring-story); transform: scaleX(0); transform-origin: left; transition: transform .7s var(--ease-expo); }
	.tp-reveal-list li:hover::after { transform: scaleX(1); }
	.rl-num { font-family: var(--font-mono); font-size: 12px; color: var(--muted); }
	.rl-name { font-size: clamp(30px, 4.4vw, 68px); font-weight: 850; font-style: italic; text-transform: uppercase; letter-spacing: -.06em; line-height: .95; color: var(--ink); transition: transform .7s var(--ease-expo), color .4s; }
	.tp-reveal-list li:hover .rl-name { transform: translateX(18px); color: var(--blue); }
	.rl-arrow { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 50%; border: 1px solid var(--line); color: var(--navy); transition: all .5s var(--ease-expo); }
	.rl-arrow :global(svg) { width: 18px; height: 18px; }
	.tp-reveal-list li:hover .rl-arrow { background: var(--navy); color: var(--mint); transform: rotate(45deg); border-color: var(--navy); }

	.rl-float { position: absolute; left: 0; top: 0; z-index: 3; width: 230px; aspect-ratio: 3 / 4; pointer-events: none; opacity: 0; scale: .6; transition: opacity .4s, scale .6s var(--ease-expo); }
	.rl-float.is-show { opacity: 1; scale: 1; }
	.rl-img { position: absolute; inset: 0; border-radius: 20px; overflow: hidden; opacity: 0; clip-path: inset(100% 0 0 0 round 20px); transition: opacity .3s, clip-path .6s var(--ease-expo); box-shadow: 0 30px 60px #16006d4d; }
	.rl-img.is-on { opacity: 1; clip-path: inset(0 0 0 0 round 20px); }
	.rl-img :global(img) { width: 100%; height: 100%; object-fit: cover; transform: scale(var(--s)); }
	.rl-img::after { content: ""; position: absolute; inset: 0; mix-blend-mode: color; opacity: .55; }
	.tint-blue::after { background: var(--blue); }
	.tint-mint::after { background: var(--mint); }
	.tint-violet::after { background: #8f60ff; }
	.tint-pink::after { background: #ff5c96; }

	/* ---------- B2 Alcance ---------- */
	.tp-reach { display: grid; grid-template-columns: 1.05fr .95fr; gap: clamp(32px, 5vw, 80px); align-items: center; background: #07031f; }
	.tp-reach-bg { position: absolute; inset: 0; z-index: -1; }
	.reach-aurora { position: absolute; width: 60vw; height: 60vw; left: -18vw; top: 50%; translate: 0 -50%; border-radius: 50%; background: radial-gradient(circle, #3158ff80 0, transparent 60%); filter: blur(40px); animation: sp-drift 20s ease-in-out infinite alternate; }
	.reach-grid { position: absolute; inset: 0; background-image: radial-gradient(#ffffff24 1px, transparent 1px); background-size: 26px 26px; -webkit-mask-image: linear-gradient(90deg, #000, transparent 70%); mask-image: linear-gradient(90deg, #000, transparent 70%); }

	.orbit-wrap { display: grid; place-items: center; }
	.orbit-sys { position: relative; width: min(560px, 82vw); aspect-ratio: 1; }
	.o-ring { position: absolute; left: 50%; top: 50%; width: calc(41% + var(--r) * 19%); aspect-ratio: 1; translate: -50% -50%; border-radius: 50%; border: 1px dashed #ffffff26; animation: sp-spin var(--dur) linear infinite; }
	.o-ring:nth-child(odd) { animation-direction: reverse; }
	.o-arm { position: absolute; inset: 0; transform: rotate(var(--a)); }
	.o-node { position: absolute; left: 50%; top: 0; width: 0; height: 0; transform: rotate(calc(-1 * var(--a))); }
	.o-planet {
		position: absolute;
		left: 0;
		top: 0;
		width: var(--sz);
		height: var(--sz);
		translate: -50% -50%;
		display: grid;
		place-content: center;
		justify-items: center;
		gap: 2px;
		border-radius: 50%;
		background: radial-gradient(circle at 30% 25%, #3158ff, var(--navy) 75%);
		box-shadow: 0 0 0 1px #ffffff33, 0 16px 40px #0d4bf766, inset 0 0 20px #5ae6cb33;
		color: #fff;
		text-decoration: none;
		transition: scale .5s var(--ease-expo), box-shadow .5s;
		/* gira ao contrário do anel para o planeta ficar sempre de pé */
		animation: sp-counter var(--dur) linear infinite;
	}
	.o-ring:nth-child(odd) .o-planet { animation-direction: reverse; }
	.o-planet:hover { scale: 1.12; box-shadow: 0 0 0 2px var(--mint), 0 16px 50px #5ae6cb66; }
	.o-ico { display: grid; width: 38%; max-width: 26px; aspect-ratio: 1; }
	.o-ico :global(svg) { width: 100%; height: 100%; }
	.o-planet b { font-size: 11px; font-weight: 800; letter-spacing: -.01em; white-space: nowrap; }
	.o-core { position: absolute; left: 50%; top: 50%; width: 24%; aspect-ratio: 1; translate: -50% -50%; border-radius: 50%; padding: 4px; background: conic-gradient(from var(--sp-angle), var(--mint), var(--blue), var(--indigo), var(--mint)); animation: sp-ring 6s linear infinite; box-shadow: 0 0 80px #0d4bf780; }
	.o-core :global(img) { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; border: 4px solid #07031f; }

	.reach-copy { display: flex; flex-direction: column; gap: 30px; }
	.reach-total { display: flex; align-items: center; gap: 18px; }
	.reach-total strong { font-size: clamp(64px, 8vw, 128px); font-weight: 850; letter-spacing: -.06em; line-height: .85; background: linear-gradient(110deg, #fff, var(--mint) 60%, var(--periwinkle)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; font-variant-numeric: tabular-nums; }
	.reach-total span { font-family: var(--font-mono); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: #9aa3d6; line-height: 1.5; }
	.reach-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; }
	.reach-list li { display: grid; grid-template-columns: 22px 90px 1fr 74px; align-items: center; gap: 14px; }
	.rli { display: grid; width: 20px; height: 20px; color: var(--mint); }
	.rli :global(svg) { width: 100%; height: 100%; }
	.rln { font-size: 14px; font-weight: 700; color: #dce4ff; }
	.rlb { height: 8px; border-radius: 999px; background: #ffffff14; overflow: hidden; }
	.rlb i { display: block; height: 100%; width: var(--w); border-radius: inherit; background: linear-gradient(90deg, var(--blue), var(--mint)); transform: scaleX(0); transform-origin: left; transition: transform 1.3s var(--ease-expo) calc(var(--sd, 0s) + .2s); }
	.reach-list li.is-in .rlb i { transform: scaleX(1); }
	.reach-list b { text-align: right; font-size: 16px; font-weight: 850; font-variant-numeric: tabular-nums; }

	/* ---------- B3 História ---------- */
	.tp-story { display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(32px, 6vw, 100px); align-items: start; background: #fff; color: var(--ink); }
	.story-photo { position: sticky; top: 90px; margin: 0; height: min(78vh, 760px); border-radius: 32px; overflow: hidden; background: var(--navy); }
	.story-photo-in { position: absolute; inset: -6% 0; will-change: transform; }
	.story-photo-in :global(img) { width: 100%; height: 100%; object-fit: cover; }
	.story-duotone { position: absolute; inset: 0; background: linear-gradient(180deg, #16006d00 40%, #16006dcc 100%), linear-gradient(135deg, #0d4bf733, #5ae6cb22); mix-blend-mode: multiply; }
	.story-photo figcaption { position: absolute; left: 20px; bottom: 20px; display: inline-flex; align-items: center; gap: 9px; padding: 8px 14px; border-radius: 999px; background: #ffffff26; backdrop-filter: blur(14px); color: #fff; font-family: var(--font-mono); font-size: 10.5px; letter-spacing: .12em; text-transform: uppercase; }

	.story-copy { display: flex; flex-direction: column; gap: 26px; padding-top: 12px; }
	.story-title { margin: 0; font-size: clamp(40px, 5.2vw, 84px); font-weight: 850; letter-spacing: -.055em; line-height: .98; }
	.sw { --lit: 0; color: color-mix(in srgb, var(--navy) calc(14% + var(--lit) * 86%), transparent); transition: color .2s linear; }
	.story-lead { margin: 0; font-size: clamp(19px, 1.7vw, 25px); line-height: 1.5; letter-spacing: -.015em; color: var(--navy); padding-left: 22px; border-left: 3px solid; border-image: var(--ring-story) 1; }
	.story-cols { columns: 2 280px; column-gap: 40px; }
	.story-cols p { margin: 0 0 18px; font-size: 16px; line-height: 1.75; color: var(--muted); break-inside: avoid; }
	.story-cols p:first-child::first-letter { float: left; font-size: 4.2em; line-height: .82; font-weight: 900; font-style: italic; margin: .06em .1em 0 0; color: var(--blue); }

	/* ---------- B4 Conteúdo ---------- */
	.tp-content { background: radial-gradient(circle at 85% 0%, #3158ff59 0, transparent 40%), linear-gradient(180deg, #100057, #07031f); padding-right: 0; }
	.content-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; padding-right: clamp(20px, 5vw, 72px); }
	.content-note { margin: 0; font-family: var(--font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: #9aa3d6; }

	.rail { display: flex; align-items: flex-end; gap: 22px; margin-top: 48px; padding: 10px clamp(20px, 5vw, 72px) 30px 0; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; cursor: grab; }
	.rail::-webkit-scrollbar { display: none; }
	.rail.is-drag { cursor: grabbing; scroll-snap-type: none; }
	.post { flex: none; scroll-snap-align: start; display: flex; flex-direction: column; border-radius: 26px; overflow: hidden; color: #fff; text-decoration: none; background: #15104a; border: 1px solid #ffffff1f; box-shadow: 0 30px 60px #00000066; transition: transform .6s var(--ease-expo), box-shadow .6s, border-color .4s; user-select: none; -webkit-user-drag: none; }
	.post :global(img) { -webkit-user-drag: none; pointer-events: none; }
	.post:hover { transform: translateY(-8px) rotate(-.6deg); border-color: #5ae6cb66; box-shadow: 0 40px 80px #0000008c, 0 0 0 1px #5ae6cb33; }
	.post-media { position: relative; overflow: hidden; background: #000; }
	.post-media :global(img) { width: 100%; height: 100%; object-fit: cover; }
	.post-media.sq { aspect-ratio: 1; }
	.post-media.tall { aspect-ratio: 9 / 16; }
	.post-media.wide { aspect-ratio: 16 / 9; }

	.post-instagram { width: 340px; background: #fff; color: #11112b; }
	.post-top { display: flex; align-items: center; gap: 10px; padding: 12px 14px; }
	.post-avatar { flex: none; width: 34px; height: 34px; border-radius: 50%; padding: 2px; background: linear-gradient(45deg, #fa7e1e, #d62976, #962fbf); overflow: hidden; }
	.post-avatar :global(img) { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; border: 2px solid #fff; }
	.post-handle { display: flex; flex-direction: column; font-size: 13px; font-weight: 700; line-height: 1.2; }
	.post-handle small { font-size: 11px; font-weight: 500; color: var(--muted); }
	.post-dots { margin-left: auto; letter-spacing: 2px; color: var(--muted); }
	.post-heart { position: absolute; left: 50%; top: 50%; width: 90px; height: 90px; color: #fff; translate: -50% -50%; scale: 0; opacity: 0; transition: scale .5s var(--ease-expo), opacity .3s; filter: drop-shadow(0 8px 20px #0006); }
	.post-heart :global(svg) { width: 100%; height: 100%; fill: #fff; }
	.post-instagram:hover .post-heart { scale: 1; opacity: 1; }
	.post-instagram .post-media :global(img) { transition: transform 1.2s var(--ease-expo); }
	.post-instagram:hover .post-media :global(img) { transform: scale(1.06); }
	.post-actions { display: flex; gap: 14px; padding: 12px 14px 4px; }
	.post-actions span { display: grid; width: 23px; height: 23px; }
	.post-actions :global(svg) { width: 100%; height: 100%; }
	.post-actions .push { margin-left: auto; }
	.post-foot { display: flex; align-items: center; gap: 6px; padding: 8px 14px 16px; font-size: 13px; }
	.post-foot.dark { padding: 14px 16px; color: #fff; }
	.post-open { margin-left: auto; display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 800; color: var(--blue); }
	.post-foot.dark .post-open, .yt-foot .post-open, .txt-card .post-open { color: var(--mint); }
	.post-open i { display: grid; width: 14px; height: 14px; transition: transform .4s var(--ease-expo); }
	.post-open :global(svg) { width: 100%; height: 100%; }
	.post:hover .post-open i { transform: rotate(45deg); }
	.post-net { display: grid; width: 16px; height: 16px; }
	.post-net :global(svg) { width: 100%; height: 100%; }

	.post-tiktok, .post-tiktokdaily { width: 290px; background: #000; }
	.post-tiktok .post-media :global(img), .post-tiktokdaily .post-media :global(img) { animation: sp-ken 12s ease-in-out infinite alternate; }
	.post-media.tall::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 50%, #000c 100%); }
	.tk-play { position: absolute; z-index: 2; left: 50%; top: 50%; width: 64px; height: 64px; padding: 18px; border-radius: 50%; background: #ffffff2e; backdrop-filter: blur(8px); color: #fff; animation: sp-beat 2.4s ease-in-out infinite; }
	.tk-play :global(svg) { width: 100%; height: 100%; }
	.tk-side { position: absolute; z-index: 2; right: 12px; bottom: 70px; display: flex; flex-direction: column; align-items: center; gap: 16px; }
	.tk-side > span { display: grid; width: 28px; height: 28px; color: #fff; filter: drop-shadow(0 2px 6px #0008); }
	.tk-side :global(svg) { width: 100%; height: 100%; }
	.tk-side .tk-av { width: 40px; height: 40px; border-radius: 50%; overflow: hidden; border: 2px solid #fff; }
	.tk-av :global(img) { width: 100%; height: 100%; object-fit: cover; }
	.tk-info { position: absolute; z-index: 2; left: 14px; right: 64px; bottom: 20px; display: flex; flex-direction: column; gap: 3px; font-size: 13px; }
	.tk-info span { font-size: 12px; color: #ffffffcc; }
	.tk-progress { position: absolute; z-index: 2; left: 0; right: 0; bottom: 0; height: 3px; background: #ffffff33; }
	.tk-progress i { display: block; height: 100%; background: #fff; transform-origin: left; animation: sp-progress 9s linear infinite; }

	.post-youtube { width: 480px; background: #0f0f1a; }
	.post-youtube .post-media :global(img) { filter: brightness(.75); transition: filter .5s, transform 1.2s var(--ease-expo); }
	.post-youtube:hover .post-media :global(img) { filter: brightness(.95); transform: scale(1.05); }
	.yt-play { position: absolute; left: 50%; top: 50%; translate: -50% -50%; width: 74px; height: 52px; padding: 13px 24px; border-radius: 16px; background: #ff0033; color: #fff; box-shadow: 0 10px 30px #ff003366; transition: scale .5s var(--ease-expo); }
	.yt-play :global(svg) { width: 100%; height: 100%; }
	.post-youtube:hover .yt-play { scale: 1.12; }
	.yt-bar { position: absolute; left: 0; right: 0; bottom: 0; height: 4px; background: #ffffff33; }
	.yt-bar i { display: block; height: 100%; background: #ff0033; transform-origin: left; animation: sp-progress 14s linear infinite; }
	.yt-foot { display: flex; align-items: center; gap: 12px; padding: 14px 16px 16px; }
	.yt-foot .post-avatar { background: #ff0033; }
	.yt-foot .post-avatar :global(img) { border-color: #0f0f1a; }
	.yt-meta { display: flex; flex-direction: column; font-size: 14px; line-height: 1.25; }
	.yt-meta span { font-size: 12px; color: #9aa3d6; }

	.post-threads, .post-x, .post-facebook { width: 260px; aspect-ratio: 3 / 4; background: linear-gradient(160deg, #1b1460, #07031f); }
	.txt-card { position: relative; flex: 1; display: flex; flex-direction: column; gap: 6px; padding: 24px; }
	.txt-ico { display: grid; width: 56px; height: 56px; padding: 14px; border-radius: 16px; background: #ffffff14; color: #fff; margin-bottom: auto; transition: transform .6s var(--ease-expo); }
	.txt-ico :global(svg) { width: 100%; height: 100%; }
	.post:hover .txt-ico { transform: rotate(-8deg) scale(1.08); }
	.txt-handle { font-family: var(--font-mono); font-size: 11px; letter-spacing: .08em; color: #9aa3d6; }
	.txt-card strong { font-size: 52px; font-weight: 850; letter-spacing: -.05em; line-height: .95; }
	.txt-sub { font-size: 13px; color: #dce4ff; }
	.txt-card .post-open { margin: 14px 0 0; }

	/* ---------- B5 Marcas ---------- */
	.tp-brands { background: #fff; color: var(--ink); padding-left: 0; padding-right: 0; }
	.tp-brands .tp-head { padding: 0 20px; }
	.brand-rows { display: flex; flex-direction: column; gap: 6px; margin-top: 54px; -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); }
	.brand-row { overflow: hidden; }
	.brand-track { display: flex; width: max-content; animation: sp-marquee 36s linear infinite; }
	.brand-row.rev .brand-track { animation-name: sp-marquee-rev; animation-duration: 44s; }
	.brand-rows:hover .brand-track { animation-play-state: paused; }
	.brand-set { display: flex; align-items: center; gap: 34px; padding-right: 34px; }
	.brand-set span { font-size: clamp(40px, 6vw, 96px); font-weight: 850; font-style: italic; text-transform: uppercase; letter-spacing: -.06em; line-height: 1.05; white-space: nowrap; color: var(--navy); transition: color .3s; }
	.brand-set span.outline { color: transparent; -webkit-text-stroke: 1.5px var(--navy); }
	.brand-set span:hover { color: var(--blue); -webkit-text-stroke-color: var(--blue); }
	.brand-set i { font-style: normal; font-size: 26px; color: var(--mint); }

	/* ---------- B6 CTA ---------- */
	.tp-cta { display: grid; grid-template-columns: 1.3fr .7fr; gap: clamp(32px, 6vw, 96px); align-items: center; min-height: 86vh; background: linear-gradient(135deg, #100057, #0d36d6 72%, #12278c); }
	.cta-bg { position: absolute; inset: 0; z-index: -1; overflow: hidden; }
	.cta-ghost { position: absolute; left: -2vw; bottom: -5vw; font-size: 24vw; font-weight: 900; font-style: italic; text-transform: uppercase; letter-spacing: -.08em; line-height: .8; white-space: nowrap; color: transparent; -webkit-text-stroke: 1px #ffffff1f; }
	.cta-aurora { position: absolute; border-radius: 50%; filter: blur(90px); animation: sp-drift 22s ease-in-out infinite alternate; }
	.cta-aurora.a { width: 40rem; height: 40rem; right: -10rem; top: -14rem; background: radial-gradient(circle, #5ae6cb 0, transparent 65%); opacity: .35; }
	.cta-aurora.b { width: 34rem; height: 34rem; left: 20%; bottom: -16rem; background: radial-gradient(circle, #8f60ff 0, transparent 65%); opacity: .3; animation-delay: -9s; }
	.cta-copy { display: flex; flex-direction: column; gap: 22px; }
	.cta-title { margin: 0; font-size: clamp(40px, 5.4vw, 92px); font-weight: 850; letter-spacing: -.055em; line-height: .95; }
	.cta-text { margin: 0; max-width: 560px; font-size: clamp(16px, 1.3vw, 19px); line-height: 1.6; color: #dce4ff; }
	.cta-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 22px; margin-top: 8px; }

	.sp-btn { display: inline-flex; text-decoration: none; }
	.sp-btn-ring { position: relative; display: inline-flex; padding: 1.5px; border-radius: 999px; overflow: hidden; isolation: isolate; }
	.sp-btn-ring::before { content: ""; position: absolute; inset: -1000%; z-index: -1; background: conic-gradient(from var(--sp-angle), transparent 0 290deg, var(--mint) 330deg, #fff 360deg); animation: sp-ring 2.4s linear infinite; }
	.sp-btn-in { display: inline-flex; align-items: center; gap: 14px; padding: 8px 8px 8px 26px; border-radius: 999px; background: #fff; color: var(--navy); font-weight: 800; font-size: 15px; }
	.sp-btn-ico { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 50%; background: var(--navy); color: var(--mint); transition: transform .5s var(--ease-expo); }
	.sp-btn-ico :global(svg) { width: 18px; height: 18px; }
	.sp-btn:hover .sp-btn-ico { transform: rotate(45deg); }
	.sp-link { position: relative; color: #fff; font-weight: 800; text-decoration: none; }
	.sp-link::after { content: ""; position: absolute; left: 0; bottom: -5px; height: 2px; width: 100%; background: var(--ring-story); transform: scaleX(.3); transform-origin: left; transition: transform .5s var(--ease-expo); }
	.sp-link:hover::after { transform: scaleX(1); }

	.next-card { position: relative; display: flex; flex-direction: column; gap: 6px; padding: 14px 14px 20px; border: 1px solid #ffffff2e; border-radius: 28px; background: #ffffff14; backdrop-filter: blur(16px); color: #fff; text-align: left; cursor: pointer; transition: transform .7s var(--ease-expo), background .4s; justify-self: end; width: min(320px, 100%); }
	.next-card:hover { transform: translateY(-8px) rotate(1.5deg); background: #ffffff21; }
	.next-k { display: inline-flex; align-items: center; justify-content: space-between; font-family: var(--font-mono); font-size: 10.5px; letter-spacing: .16em; text-transform: uppercase; color: var(--mint); padding: 4px 4px 10px; }
	.next-k i { display: grid; width: 16px; height: 16px; transition: transform .5s var(--ease-expo); }
