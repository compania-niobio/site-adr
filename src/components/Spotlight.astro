	[data-sr] { opacity: 0; transform: translateY(36px); filter: blur(8px); transition: opacity 1s var(--ease-expo) var(--sd, 0s), transform 1s var(--ease-expo) var(--sd, 0s), filter 1s var(--ease-expo) var(--sd, 0s); }
